{
  "openapi": "3.1.0",
  "info": {
    "title": "MyScoutee internal content media visibility reads",
    "version": "1.0.0",
    "description": "Typed canonical content media-policy projections. Read-only service credential supplies facts, not delegated user authority. Explicit REAL/DEMO context and bounded queries; HTTPS except isolated-lab opt-in."
  },
  "paths": {
    "/_internal/v1/content/media-visibility": {
      "post": {
        "operationId": "getContentMediaVisibility",
        "security": [
          {
            "contentMediaRead": []
          }
        ],
        "parameters": [
          {
            "name": "X-MyScoutee-Session-Mode",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "REAL",
                "DEMO"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Canonical media-policy projection. Maximum response 4 KiB.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FeedPostMediaVisibilityDto"
                }
              }
            }
          },
          "400": {
            "description": "INVALID_SESSION_MODE or INVALID_REQUEST",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "UNAUTHORIZED: absent, duplicate or wrong read credential",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "FORBIDDEN: credential does not authorize another path or method",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "CONTENT_VISIBILITY_UNAVAILABLE: owner failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "NOT_FOUND: no matching reference in the selected mode.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "QUERY_TOO_LARGE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "INVALID_CONTENT_TYPE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "description": "Maximum 1 MiB of JSON, including chunked requests.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MediaUrlsQueryDto"
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "contentMediaRead": {
        "type": "http",
        "scheme": "bearer",
        "description": "Dedicated content-media read credential of at least 256 random bits; never expose to browsers."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "code"
        ],
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "INVALID_REQUEST",
              "INVALID_SESSION_MODE",
              "UNAUTHORIZED",
              "FORBIDDEN",
              "NOT_FOUND",
              "CONTENT_VISIBILITY_UNAVAILABLE",
              "QUERY_TOO_LARGE",
              "INVALID_CONTENT_TYPE"
            ]
          }
        }
      },
      "MediaUrlsQueryDto": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "urls"
        ],
        "properties": {
          "urls": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 24576
            }
          }
        }
      },
      "FeedPostMediaVisibilityDto": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "moderationStatus"
        ],
        "properties": {
          "moderationStatus": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
