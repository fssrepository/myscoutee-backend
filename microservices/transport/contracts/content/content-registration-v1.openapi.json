                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Canonical owner unavailable; operation outcome is not assumed successful",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Canonical owner rejection",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Canonical owner rejection",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "410": {
            "description": "Canonical owner rejection",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Canonical owner rejection",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "serviceCapability": {
        "type": "http",
        "scheme": "bearer",
        "description": "Dedicated content-registration producer capability."
      }
    },
    "schemas": {
      "Snapshot": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "revision": {
            "type": "integer"
          },
          "settings": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Settings"
              },
              {
                "type": "null"
              }
            ]
          },
          "counts": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": {
                "type": [
                  "integer",
                  "null"
                ]
              }
            }
          },
          "pendingCount": {
            "type": "integer"
          }
        },
        "required": [
          "revision",
          "pendingCount"
        ]
      },
      "Settings": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "autoApprove": {
            "type": "boolean"
          },
          "delayMinutes": {
            "type": "integer"
          },
          "categories": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "required": [
          "autoApprove",
          "delayMinutes"
        ]
      },
      "Item": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": [
              "string",
              "null"
            ]
          },
          "category": {
            "type": [
              "string",
              "null"
            ]
          },
          "sourceId": {
            "type": [
              "string",
              "null"
            ]
          },
          "ownerUserId": {
            "type": [
              "string",
              "null"
            ]
          },
          "title": {
            "type": [
              "string",
              "null"
            ]
          },
          "imageUrl": {
            "type": [
              "string",
              "null"
            ]
          },
          "submittedAtIso": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": [
              "string",
              "null"
            ]
          },
          "version": {
            "type": "integer"
          },
          "commandId": {
            "type": [
              "string",
              "null"
            ]
          },
          "reviewedBy": {
            "type": [
              "string",
              "null"
            ]
          },
          "reviewedAtIso": {
            "type": [
              "string",
              "null"
            ]
          },
          "publiclyVisibleOnce": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "deleted": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "workspaceGroupId": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "version"
        ]
      },
      "Query": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "scope": {
            "$ref": "#/components/schemas/Scope"
          }
        },
        "required": [
          "scope"
        ]
      },
      "Register": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "scope": {
            "$ref": "#/components/schemas/Scope"
          },
          "category": {
            "enum": [
              "asset",
              "event",
              "feed",
              "group"
            ]
          },
          "sourceId": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 512
          },
          "ownerId": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 512
          },
          "title": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 8192
          },
          "imageUrl": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 24576
          }
        },
        "required": [
          "scope",
          "category"
        ]
      },
      "Scope": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "active": {
            "type": "boolean"
          },
          "groupId": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 512
          }
        },
        "required": [
          "active"
        ]
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "INVALID_REQUEST",
              "INVALID_SESSION_MODE",
              "UNAUTHORIZED",
              "FORBIDDEN",
              "QUERY_TOO_LARGE",
              "INVALID_CONTENT_TYPE",
              "CONTENT_REGISTRATION_UNAVAILABLE",
              "OWNER_REJECTED"
            ]
          }
        },
        "required": [
          "code"
        ]
      }
    }
  }
}
