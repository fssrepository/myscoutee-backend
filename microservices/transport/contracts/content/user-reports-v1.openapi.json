{
  "openapi": "3.1.0",
  "info": {
    "title": "MyScoutee internal user report submissions",
    "version": "1.0.0",
    "description": "Canonical user report submission and sync-key reconciliation. Both service capability and identity-issued RS256 actor delegation are required. Each assertion binds body bytes, operation, path, POST and REAL/DEMO mode. Actor must match the submitted user. Canonical duplicate-sync-key receipt is retained; transport never retries automatically."
  },
  "paths": {
    "/_internal/v1/content/user-reports/submit": {
      "post": {
        "operationId": "userReportSubmit",
        "security": [
          {
            "serviceCapability": []
          }
        ],
        "parameters": [
          {
            "name": "X-MyScoutee-Session-Mode",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "REAL",
                "DEMO"
              ]
            }
          },
          {
            "name": "X-MyScoutee-Actor-Delegation",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 8192
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReportDraft"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Canonical receipt (including duplicate) or existence result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Receipt"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request or session mode",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing/wrong service capability",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Invalid actor delegation or actor mismatch",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Body exceeds 64 KiB",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "JSON content type required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Outcome unknown; do not create a new retry ID",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/_internal/v1/content/user-reports/exists": {
      "post": {
        "operationId": "userReportExists",
        "security": [
          {
            "serviceCapability": []
          }
        ],
        "parameters": [
          {
            "name": "X-MyScoutee-Session-Mode",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "REAL",
                "DEMO"
              ]
            }
          },
          {
            "name": "X-MyScoutee-Actor-Delegation",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 8192
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExistsQuery"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Canonical receipt (including duplicate) or existence result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExistsResult"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request or session mode",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing/wrong service capability",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Invalid actor delegation or actor mismatch",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Body exceeds 64 KiB",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "JSON content type required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Outcome unknown; do not create a new retry ID",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "serviceCapability": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "INVALID_SESSION_MODE",
              "INVALID_REQUEST",
              "UNAUTHORIZED",
              "FORBIDDEN",
              "INVALID_DELEGATION",
              "ACTOR_MISMATCH",
              "QUERY_TOO_LARGE",
              "INVALID_CONTENT_TYPE",
              "REQUEST_CONFLICT",
              "SUBMISSION_OUTCOME_UNKNOWN",
              "REPORT_READ_UNAVAILABLE"
            ]
          }
        }
      },
      "ReportDraft": {
        "type": "object",
        "required": [
          "syncKey",
          "userId"
        ],
        "additionalProperties": false,
        "properties": {
          "syncKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "userId": {
            "type": "string"
          },
          "handle": {
            "type": [
              "string",
              "null"
            ]
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "details": {
            "type": [
              "string",
              "null"
            ]
          },
          "targetUserId": {
            "type": [
              "string",
              "null"
            ]
          },
          "memberEntryId": {
            "type": [
              "string",
              "null"
            ]
          },
          "eventId": {
            "type": [
              "string",
              "null"
            ]
          },
          "eventTitle": {
            "type": [
              "string",
              "null"
            ]
          },
          "eventStartAtIso": {
            "type": [
              "string",
              "null"
            ]
          },
          "sourceType": {
            "type": [
              "string",
              "null"
            ]
          },
          "sourceId": {
            "type": [
              "string",
              "null"
            ]
          },
          "sourceText": {
            "type": [
              "string",
              "null"
            ]
          },
          "chatId": {
            "type": [
              "string",
              "null"
            ]
          },
          "messageId": {
            "type": [
              "string",
              "null"
            ]
          },
          "assetId": {
            "type": [
              "string",
              "null"
            ]
          },
          "assetType": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "Receipt": {
        "type": "object",
        "required": [
          "id",
          "duplicate"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": [
              "string",
              "null"
            ]
          },
          "duplicate": {
            "type": "boolean"
          }
        }
      },
      "ExistsQuery": {
        "type": "object",
        "required": [
          "syncKey"
        ],
        "additionalProperties": false,
        "properties": {
          "syncKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        }
      },
      "ExistsResult": {
        "type": "object",
        "required": [
          "exists"
        ],
        "additionalProperties": false,
        "properties": {
          "exists": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
