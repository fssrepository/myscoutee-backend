  "info": {
    "title": "Authenticated administrator and base-workspace resolution",
    "version": "1.0.0",
    "description": "Administration-owned administrator and base-workspace reads. Require service capability and identity-issued A authority. The native owner still verifies admin email and base-profile membership. No moderation writes are exposed."
  },
