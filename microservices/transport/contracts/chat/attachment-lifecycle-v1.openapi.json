  "components": {
    "securitySchemes": {
      "serviceCapability": {
        "type": "http",
        "scheme": "bearer",
        "description": "Dedicated attachment-lifecycle producer capability."
      }
    },
    "schemas": {
      "Change": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "scope": {
            "$ref": "#/components/schemas/Scope"
          },
          "id": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 512
          },
          "reason": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 8192
          }
        },
        "required": [
          "scope"
        ]
      },
      "Receipt": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "completed": {
            "const": true
          }
        },
        "required": [
          "completed"
        ]
      },
      "Scope": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "active": {
            "type": "boolean"
          },
          "groupId": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 512
          }
        },
        "required": [
          "active"
        ]
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "INVALID_REQUEST",
              "INVALID_SESSION_MODE",
              "UNAUTHORIZED",
              "FORBIDDEN",
              "QUERY_TOO_LARGE",
              "INVALID_CONTENT_TYPE",
              "ATTACHMENT_LIFECYCLE_UNAVAILABLE"
            ]
          }
        },
        "required": [
          "code"
        ]
      },
      "Projection": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "entityId",
          "revision",
          "available"
        ],
        "properties": {
          "type": {
            "enum": [
              "asset",
              "event"
            ]
          },
          "entityId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          },
          "available": {
            "type": "boolean"
          },
          "reason": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 8192
          }
        }
      },
      "Project": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scope",
          "projection"
        ],
        "properties": {
          "scope": {
            "$ref": "#/components/schemas/Scope"
          },
          "projection": {
            "$ref": "#/components/schemas/Projection"
          }
        }
      }
    }
  }
