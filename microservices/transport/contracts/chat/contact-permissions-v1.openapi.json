            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "REAL",
                "DEMO"
              ]
            }
          },
          {
            "name": "X-MyScoutee-Actor-Delegation",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 8192
            }
