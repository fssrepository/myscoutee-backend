{
  "openapi": "3.1.0",
  "info": {
    "title": "MyScoutee internal case participant reads",
    "version": "1.0.0",
    "description": "Existing CaseParticipants conversation, active membership and menu count operations. Canonical service retains accepted membership, private-offer separation, trash filtering and integer count cap. Dedicated read credential does not delegate actor authority. Explicit REAL/DEMO; HTTPS except isolated-lab opt-in."
  },
  "paths": {
    "/_internal/v1/community/cases/conversation": {
      "get": {
        "operationId": "getCaseConversation",
        "security": [
          {
            "caseParticipantsRead": []
          }
        ],
        "parameters": [
          {
            "name": "X-MyScoutee-Session-Mode",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "REAL",
                "DEMO"
              ]
            }
          },
          {
            "name": "caseId",
            "in": "query",
            "required": false,
            "description": "Omission retains canonical null; empty remains distinct.",
            "schema": {
              "type": "string",
              "maxLength": 512
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Canonical read result; maximum 2 MiB; missing case is 404, existing empty membership remains an empty list.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CaseConversation"
                }
              }
            }
          },
          "400": {
            "description": "INVALID_SESSION_MODE or INVALID_REQUEST",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "UNAUTHORIZED: absent, duplicate or wrong read credential",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "FORBIDDEN: credential does not authorize another path or method",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "CASE_PARTICIPANTS_UNAVAILABLE: canonical owner failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "NOT_FOUND: no matching reference in the selected mode.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/_internal/v1/community/cases/active-accounts": {
      "get": {
        "operationId": "getActiveCaseAccounts",
        "security": [
          {
            "caseParticipantsRead": []
          }
        ],
        "parameters": [
          {
            "name": "X-MyScoutee-Session-Mode",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "REAL",
                "DEMO"
              ]
            }
          },
          {
            "name": "caseId",
            "in": "query",
            "required": false,
            "description": "Omission retains canonical null; empty remains distinct.",
            "schema": {
              "type": "string",
              "maxLength": 512
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Canonical read result; maximum 2 MiB; missing case is 404, existing empty membership remains an empty list.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActiveAccounts"
                }
              }
            }
          },
          "400": {
            "description": "INVALID_SESSION_MODE or INVALID_REQUEST",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "UNAUTHORIZED: absent, duplicate or wrong read credential",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "FORBIDDEN: credential does not authorize another path or method",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "CASE_PARTICIPANTS_UNAVAILABLE: canonical owner failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "NOT_FOUND: no matching reference in the selected mode.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/_internal/v1/community/cases/visible-count": {
      "post": {
        "operationId": "countVisibleCases",
        "security": [
          {
            "caseParticipantsRead": []
          }
        ],
        "parameters": [
          {
            "name": "X-MyScoutee-Session-Mode",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "REAL",
                "DEMO"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Canonical read result; maximum 4 KiB; absence of matching cases is zero.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Count"
                }
              }
            }
          },
          "400": {
            "description": "INVALID_SESSION_MODE or INVALID_REQUEST",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "UNAUTHORIZED: absent, duplicate or wrong read credential",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "FORBIDDEN: credential does not authorize another path or method",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "CASE_PARTICIPANTS_UNAVAILABLE: canonical owner failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "QUERY_TOO_LARGE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "INVALID_CONTENT_TYPE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "description": "Maximum 1 MiB of JSON, including chunked requests.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CaseVisibilityQueryDto"
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "caseParticipantsRead": {
        "type": "http",
        "scheme": "bearer",
        "description": "Dedicated case-participants read secret of at least 256 random bits; internal callers only."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "code"
        ],
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "INVALID_REQUEST",
              "INVALID_SESSION_MODE",
              "UNAUTHORIZED",
              "FORBIDDEN",
              "NOT_FOUND",
              "CASE_PARTICIPANTS_UNAVAILABLE",
              "QUERY_TOO_LARGE",
              "INVALID_CONTENT_TYPE"
            ]
          }
        }
      },
      "CaseConversation": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "baseGroupId",
          "title",
          "activeParticipantAccountIds",
          "chatParticipantAccountIds",
          "offers"
        ],
        "properties": {
          "id": {
            "type": [
              "string",
              "null"
            ]
          },
          "baseGroupId": {
            "type": [
              "string",
              "null"
            ]
          },
          "title": {
            "type": [
              "string",
              "null"
            ]
          },
          "activeParticipantAccountIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "chatParticipantAccountIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "offers": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "amount",
                "currency",
                "participants"
              ],
              "properties": {
                "id": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "amount": {
                  "type": "number"
                },
                "currency": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "participants": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      },
      "ActiveAccounts": {
        "type": "array",
        "items": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "Count": {
        "type": "integer",
        "minimum": 0,
        "maximum": 2147483647
      },
      "CaseVisibilityQueryDto": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "baseGroupId",
          "accountId",
          "managedGroupIds"
        ],
        "properties": {
          "baseGroupId": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 512
          },
          "accountId": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 512
          },
          "managedGroupIds": {
            "type": [
              "array",
              "null"
            ],
            "maxItems": 4096,
            "items": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 512
            }
          }
        }
      }
    }
  }
}
