                }
              }
            }
          },
          "404": {
            "description": "NOT_FOUND: the canonical directory has no group for this ID in the selected session mode.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "notificationCatalogRead": {
        "type": "http",
        "scheme": "bearer",
        "description": "Dedicated internal group-media read credential of at least 256 random bits. Never distribute to browsers or put in URLs."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "code"
        ],
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "INVALID_SESSION_MODE",
              "INVALID_REQUEST",
              "UNAUTHORIZED",
              "FORBIDDEN",
              "NOT_FOUND",
              "NOTIFICATION_CATALOG_UNAVAILABLE"
            ]
          }
        }
      },
      "Count": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9223372036854775807
      },
      "Template": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "templateKey",
          "enabled",
          "titleTemplate",
          "bodyTemplate",
          "iconUrl",
          "badgeUrl",
          "ctaPath"
        ],
        "properties": {
          "templateKey": {
            "type": [
              "string",
              "null"
            ]
          },
          "enabled": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "titleTemplate": {
            "type": [
              "string",
              "null"
            ]
          },
          "bodyTemplate": {
            "type": [
              "string",
              "null"
            ]
          },
          "iconUrl": {
            "type": [
              "string",
              "null"
            ]
          },
          "badgeUrl": {
            "type": [
              "string",
              "null"
            ]
          },
          "ctaPath": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
