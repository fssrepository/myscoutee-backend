    "/_internal/v1/notifications/catalog/template": {
      "get": {
        "operationId": "findNotificationTemplate",
        "security": [
          {
            "notificationCatalogRead": []
          }
        ],
        "parameters": [
          {
            "name": "X-MyScoutee-Session-Mode",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "REAL",
                "DEMO"
              ]
            }
          },
          {
            "name": "templateKey",
            "in": "query",
            "required": false,
            "description": "Omission preserves canonical null; empty string remains distinct.",
            "schema": {
              "type": "string",
              "maxLength": 512
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Canonical read result; maximum 2 MiB.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Template"
                }
              }
            }
          },
          "400": {
            "description": "INVALID_SESSION_MODE or INVALID_REQUEST",
            "content": {
              "application/json": {
                "schema": {
