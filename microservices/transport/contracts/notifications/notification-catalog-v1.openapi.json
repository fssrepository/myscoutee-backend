{
  "openapi": "3.1.0",
  "info": {
    "title": "MyScoutee internal notification catalog reads",
    "version": "1.0.0",
    "description": "Existing NotificationCatalog counters and detached rendering template. Canonical owners retain failed-rule counting and repository scope. Dedicated service credential is not delegated user authority; explicit REAL/DEMO mode, HTTPS except isolated-lab opt-in."
  },
  "paths": {
    "/_internal/v1/notifications/catalog/unread": {
      "get": {
        "operationId": "countUnreadNotifications",
        "security": [
          {
            "notificationCatalogRead": []
          }
        ],
        "parameters": [
          {
            "name": "X-MyScoutee-Session-Mode",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "REAL",
                "DEMO"
              ]
            }
          },
          {
            "name": "userId",
            "in": "query",
            "required": false,
            "description": "Omission preserves canonical null; empty string remains distinct.",
            "schema": {
              "type": "string",
              "maxLength": 512
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Canonical read result; maximum 4 KiB.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Count"
                }
              }
            }
          },
          "400": {
            "description": "INVALID_SESSION_MODE or INVALID_REQUEST",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "UNAUTHORIZED: absent, duplicate or wrong read credential",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "FORBIDDEN: credential does not authorize another path or method",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "NOTIFICATION_CATALOG_UNAVAILABLE: owner failed; persistence details are not exposed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
