            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "NOTIFICATION_CATALOG_UNAVAILABLE: owner failed; persistence details are not exposed.",
