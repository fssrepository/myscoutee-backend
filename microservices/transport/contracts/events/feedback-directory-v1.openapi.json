                ]
              }
            },
            "submittedAtIso": {
              "type": [
                "string",
                "null"
              ]
            },
            "createdDate": {
              "type": [
                "string",
                "null"
              ]
            },
            "createdUser": {
              "type": [
                "string",
                "null"
              ]
            },
            "updatedDate": {
              "type": [
                "string",
                "null"
              ]
            },
            "updatedUser": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      }
    }
  }
}
