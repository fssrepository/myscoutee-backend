{
  "openapi": "3.1.0",
  "info": {
    "title": "MyScoutee internal event-home-reads reads",
    "version": "1.0.0",
    "description": "Existing home activity projection and report eligibility reads. Canonical owner queries and caller rules are unchanged. Dedicated credential, REAL/DEMO scope, GET only, no delegated user authority, 2 MiB response limit."
  },
  "paths": {
    "/_internal/v1/events/home-reads/source": {
      "get": {
        "operationId": "readEventHomeReads",
        "security": [
          {
            "event-home-reads": []
          }
        ],
        "parameters": [
          {
            "name": "X-MyScoutee-Session-Mode",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "REAL",
                "DEMO"
              ]
            }
          },
          {
            "name": "sourceId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 512
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Existing membership-policy facts; bounded to 2 MiB.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventHomeReadsResponse"
                }
              }
            }
          },
          "400": {
            "description": "INVALID_SESSION_MODE or INVALID_REQUEST",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "UNAUTHORIZED: absent, duplicate or wrong read credential",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "FORBIDDEN: credential does not authorize another path or method",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "EVENT_HOME_READS_UNAVAILABLE: owner failed; persistence details are not exposed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/_internal/v1/events/home-reads/home": {
      "get": {
        "operationId": "readHomeGameMemberProjections",
        "security": [
          {
            "event-home-reads": []
          }
        ],
        "parameters": [
          {
            "name": "X-MyScoutee-Session-Mode",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "REAL",
                "DEMO"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Existing membership-policy facts; bounded to 2 MiB.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventHomeReadsResponse"
                }
              }
            }
          },
          "400": {
            "description": "INVALID_SESSION_MODE or INVALID_REQUEST",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "UNAUTHORIZED: absent, duplicate or wrong read credential",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "FORBIDDEN: credential does not authorize another path or method",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "EVENT_HOME_READS_UNAVAILABLE: owner failed; persistence details are not exposed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "event-home-reads": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "code"
        ],
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "INVALID_SESSION_MODE",
              "INVALID_REQUEST",
              "UNAUTHORIZED",
              "FORBIDDEN",
              "NOT_FOUND",
              "EVENT_HOME_READS_UNAVAILABLE"
            ]
          }
        }
      },
      "EventHomeReadsResponse": {
        "type": "array",
        "items": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "acceptedMemberUserIds",
            "startAtIso",
            "updatedDate",
            "createdDate",
            "endAtIso",
            "sourceId",
            "status",
            "ownerUserId",
            "creatorUserId",
            "admins",
            "acceptedMembers",
            "isTrashed",
            "title"
          ],
          "properties": {
            "acceptedMemberUserIds": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "startAtIso": {
              "type": [
                "string",
                "null"
              ]
            },
            "updatedDate": {
              "type": [
                "string",
                "null"
              ]
            },
            "createdDate": {
              "type": [
                "string",
                "null"
              ]
            },
            "endAtIso": {
              "type": [
                "string",
                "null"
              ]
            },
            "sourceId": {
              "type": [
                "string",
                "null"
              ]
            },
            "status": {
              "type": [
                "string",
                "null"
              ]
            },
            "ownerUserId": {
              "type": [
                "string",
                "null"
              ]
            },
            "creatorUserId": {
              "type": [
                "string",
                "null"
              ]
            },
            "admins": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "acceptedMembers": {
              "type": [
                "integer",
                "null"
              ]
            },
            "isTrashed": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "title": {
