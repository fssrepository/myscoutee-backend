{
  "openapi": "3.1.0",
  "info": {
    "title": "MyScoutee event-resource-directory",
    "version": "1.0.0",
    "description": "Chat receives only its existing resource/stage views in bounded batches; asset assignment, capacities, supply quantities and stage group count retain native query semantics. Booking/payment documents remain with their owner. Mandatory service capability, REAL/DEMO and job scope. 2 MiB request and 8 MiB response limits. No-store."
  },
  "paths": {
    "/_internal/v1/events/event-resource-directory/resources": {
      "post": {
        "operationId": "event_resource_directory_resources",
        "security": [
          {
            "serviceCapability": []
          }
        ],
        "parameters": [
          {
            "name": "X-MyScoutee-Session-Mode",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "REAL",
                "DEMO"
              ]
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Resources"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Canonical owner result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResourceList"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or session mode",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong service capability",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Request exceeds byte limit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "JSON content type required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Canonical owner unavailable; operation outcome is not assumed successful",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/_internal/v1/events/event-resource-directory/stages": {
      "post": {
        "operationId": "event_resource_directory_stages",
        "security": [
          {
            "serviceCapability": []
          }
        ],
        "parameters": [
          {
            "name": "X-MyScoutee-Session-Mode",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "REAL",
                "DEMO"
              ]
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Stages"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Canonical owner result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StageList"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or session mode",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong service capability",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Request exceeds byte limit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "JSON content type required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Canonical owner unavailable; operation outcome is not assumed successful",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "serviceCapability": {
        "type": "http",
        "scheme": "bearer",
        "description": "Dedicated server-only event-resource-directory capability."
      }
    },
    "schemas": {
      "Resources": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "scope": {
            "$ref": "#/components/schemas/Scope"
          },
          "owners": {
            "type": "array",
            "items": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 512
            },
            "maxItems": 4096
          },
          "assetOwners": {
            "type": "array",
            "items": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 512
            },
            "maxItems": 4096
          },
          "status": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 64
          }
        },
        "required": [
          "scope",
          "owners",
          "assetOwners"
        ]
      },
      "Stages": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "scope": {
            "$ref": "#/components/schemas/Scope"
          },
          "owners": {
            "type": "array",
            "items": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 512
            },
            "maxItems": 4096
          },
          "status": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 64
          }
        },
        "required": [
          "scope",
          "owners"
        ]
      },
      "ResourceList": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/Resource"
        }
      },
      "StageList": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/Stage"
        }
      },
      "Stage": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "ownerId": {
            "type": [
              "string",
              "null"
            ]
          },
          "subEventId": {
            "type": [
              "string",
              "null"
            ]
          },
          "groupsCount": {
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "required": []
      },
      "Resource": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": [
              "string",
              "null"
            ]
          },
          "recordId": {
            "type": [
              "string",
              "null"
            ]
          },
          "ownerId": {
            "type": [
              "string",
              "null"
            ]
          },
          "subEventId": {
            "type": [
              "string",
              "null"
            ]
          },
          "assetOwnerUserId": {
            "type": [
              "string",
              "null"
            ]
          },
          "assetAssignmentIds": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "assetSettingsByType": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/Settings"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "supplyContributionEntriesByAssetId": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "anyOf": [
                      {
                        "$ref": "#/components/schemas/Contribution"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "required": []
      },
      "Settings": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "capacityMin": {
            "type": [
              "integer",
              "null"
            ]
          },
          "capacityMax": {
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "required": []
      },
      "Contribution": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "quantity": {
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "required": []
      },
      "Scope": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "active": {
            "type": "boolean"
          },
          "groupId": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 512
          }
        },
        "required": [
          "active"
        ]
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "INVALID_REQUEST",
              "INVALID_SESSION_MODE",
              "UNAUTHORIZED",
              "FORBIDDEN",
              "QUERY_TOO_LARGE",
              "INVALID_CONTENT_TYPE",
              "EVENT_RESOURCE_DIRECTORY_UNAVAILABLE"
            ]
          }
        },
        "required": [
          "code"
        ]
      }
    }
  }
}
