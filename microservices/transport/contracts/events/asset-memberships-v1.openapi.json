{
  "openapi": "3.1.0",
  "info": {
    "title": "MyScoutee asset-memberships",
    "version": "1.0.0",
    "description": "Asset producer authorization remains at assets; the events owner retains membership snapshot compare-and-set and repository deletion. Exact existing detached member DTO reused. No ActivityMember cast across the boundary. REAL/DEMO and job scope preserved. 2 MiB request and 8 MiB response bounds; no-store. Cross-owner write/reply recovery remains milestone 16."
  },
