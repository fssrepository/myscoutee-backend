{
  "openapi": "3.1.0",
  "info": {
    "title": "MyScoutee ticket-audit",
    "version": "1.0.0",
    "description": "Existing already-used ticket audit. Only ticket facts, event source ID, actor and attempt timestamp cross the boundary; no full event payload is required. REAL/DEMO and job scope preserved. 2 MiB request and 8 MiB response bounds; no-store. Cross-owner write/reply recovery remains milestone 16."
  },
  "paths": {
    "/_internal/v1/events/ticket-audit/replay": {
      "post": {
        "operationId": "ticket_audit_replay",
        "security": [
          {
            "serviceCapability": []
          }
        ],
        "parameters": [
          {
            "name": "X-MyScoutee-Session-Mode",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "REAL",
                "DEMO"
              ]
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Replay"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Canonical owner result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Receipt"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or session mode",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong service capability",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Request exceeds byte limit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "JSON content type required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Canonical owner unavailable; operation outcome is not assumed successful",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "serviceCapability": {
        "type": "http",
        "scheme": "bearer",
        "description": "Dedicated ticket-audit producer capability."
      }
    },
    "schemas": {
      "ParticipationTicketDto": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": [
              "string",
              "null"
            ]
          },
          "code": {
            "type": [
              "string",
              "null"
            ]
          },
          "eventId": {
            "type": [
              "string",
              "null"
            ]
          },
          "holderUserId": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": [
              "string",
              "null"
            ]
          },
          "issuedAtIso": {
            "type": [
              "string",
              "null"
            ]
          },
          "usedAtIso": {
            "type": [
              "string",
              "null"
            ]
          },
          "usedByUserId": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": []
      },
      "Replay": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "scope": {
            "$ref": "#/components/schemas/Scope"
          },
          "ticket": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ParticipationTicketDto"
              },
              {
                "type": "null"
              }
            ]
          },
          "eventSourceId": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 512
          },
          "actor": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 512
          },
          "at": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "scope"
        ]
      },
      "Receipt": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "completed": {
            "const": true
          }
        },
        "required": [
          "completed"
        ]
      },
      "Scope": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "active": {
            "type": "boolean"
          },
          "groupId": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 512
          }
        },
        "required": [
          "active"
        ]
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "INVALID_REQUEST",
              "INVALID_SESSION_MODE",
              "UNAUTHORIZED",
              "FORBIDDEN",
              "QUERY_TOO_LARGE",
              "INVALID_CONTENT_TYPE",
              "TICKET_AUDIT_UNAVAILABLE"
            ]
          }
        },
        "required": [
          "code"
        ]
      }
    }
  }
}
