                "type": "null"
              }
            ]
          },
          "eventRecordId": {
            "type": [
              "string",
              "null"
            ]
          },
          "actorUserId": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "scope"
        ]
      },
      "microservices_transport_events_PartnerInvitationAdmissionProtocol_Scope": {
        "type": "object",
