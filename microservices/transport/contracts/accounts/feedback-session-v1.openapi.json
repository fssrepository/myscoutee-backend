{
  "openapi": "3.1.0",
  "info": {
    "title": "Selected feedback session",
    "version": "1.0.0",
    "description": "Signed selected actor is revalidated at the accounts owner. Native profile resolution returns public summary and the four stored feedback counts from the same document. No recomputation, profile reconstruction or new visibility filter. Request 16 KiB, response 256 KiB; no retries."
  },
  "paths": {
    "/_internal/v1/accounts/feedback-session": {
      "post": {
        "security": [
          {
            "serviceCapability": []
          }
        ],
        "parameters": [
          {
            "in": "header",
            "name": "X-MyScoutee-Session-Mode",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "REAL",
                "DEMO"
              ]
            }
          },
          {
            "in": "header",
            "name": "X-MyScoutee-Actor-Delegation",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 8192
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Request"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "resolved"
                  ],
                  "properties": {
                    "resolved": {
                      "const": true
                    },
                    "value": {
                      "type": [
                        "object",
                        "null"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "profile": {
                          "type": [
                            "object",
                            "null"
                          ],
                          "additionalProperties": false,
                          "properties": {
                            "userId": {
                              "type": [
                                "string",
                                "null"
                              ]
                            },
                            "accountUserId": {
                              "type": [
                                "string",
                                "null"
                              ]
                            },
                            "workspaceGroupId": {
                              "type": [
                                "string",
                                "null"
                              ]
                            },
                            "deletedAtIso": {
                              "type": [
                                "string",
                                "null"
                              ]
                            },
                            "profileStatus": {
                              "type": [
                                "string",
                                "null"
                              ]
                            },
                            "status": {
                              "type": [
                                "string",
                                "null"
                              ]
                            },
                            "hostTier": {
                              "type": [
                                "string",
                                "null"
                              ]
                            },
                            "statusText": {
                              "type": [
                                "string",
                                "null"
                              ]
                            },
                            "name": {
                              "type": [
                                "string",
                                "null"
                              ]
                            },
                            "initials": {
                              "type": [
                                "string",
                                "null"
                              ]
                            },
                            "gender": {
                              "type": [
                                "string",
                                "null"
                              ]
                            },
                            "images": {
                              "type": [
                                "array",
                                "null"
                              ],
                              "items": {
                                "type": [
                                  "string",
                                  "null"
                                ]
                              }
                            },
                            "age": {
                              "type": [
                                "integer",
                                "null"
                              ]
                            },
                            "city": {
                              "type": [
                                "string",
                                "null"
                              ]
                            },
                            "headline": {
                              "type": [
                                "string",
                                "null"
                              ]
                            },
                            "traitLabel": {
                              "type": [
                                "string",
                                "null"
                              ]
                            },
                            "about": {
                              "type": [
                                "string",
                                "null"
                              ]
                            }
                          }
                        },
                        "feedback": {
                          "type": [
                            "object",
                            "null"
                          ],
                          "additionalProperties": false,
                          "properties": {
                            "ownEvents": {
                              "type": [
                                "integer",
                                "null"
                              ]
                            },
                            "pending": {
                              "type": [
                                "integer",
                                "null"
                              ]
                            },
                            "feedbacked": {
                              "type": [
                                "integer",
                                "null"
                              ]
                            },
                            "removed": {
                              "type": [
                                "integer",
                                "null"
                              ]
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Rejected or unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Rejected or unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Rejected or unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Rejected or unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "Rejected or unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Rejected or unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "serviceCapability": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Request": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "requestedUserId": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 512
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "code"
        ],
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          }
        }
      }
    }
  }
}
