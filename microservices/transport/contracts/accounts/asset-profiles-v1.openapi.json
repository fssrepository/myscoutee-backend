            ]
          },
          "repeatCount": {
            "type": [
              "integer",
              "null"
            ]
          },
          "traitEvidenceCounts": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": [
                "integer",
                "null"
              ]
            }
          }
        }
      },
      "AssetProfile": {
        "type": "object",
        "additionalProperties": false,
