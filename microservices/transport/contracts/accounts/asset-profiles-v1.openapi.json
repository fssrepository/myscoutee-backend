{
  "openapi": "3.1.0",
  "info": {
    "title": "Asset profile facts",
    "version": "1.0.0",
    "description": "Account-owned asset participant and ticket presentation, account-to-workspace lookup, and stored asset-affinity inputs. No email, payment maps, devices, integration settings or full personality profiles. Native selection is retained; reads fail on transport bounds instead of silently truncating."
  },
