{
  "openapi": "3.1.0",
  "info": {
    "title": "MyScoutee internal profile identities",
    "version": "1.0.0",
    "description": "Focused ProfileIdentities read port: profile/account/workspace mapping and workspace profile IDs. No profile snapshot, presentation, email, devices or financial data. Dedicated service credential is required; it does not establish user or administrator authority. REAL/DEMO is mandatory. HTTPS except isolated-lab opt-in."
  },
  "paths": {
    "/_internal/v1/accounts/identities/profile": {
      "get": {
        "operationId": "findProfileIdentity",
        "security": [
          {
            "profileIdentitiesRead": []
          }
        ],
        "parameters": [
          {
            "name": "X-MyScoutee-Session-Mode",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "REAL",
                "DEMO"
              ]
            }
          },
          {
            "name": "userId",
            "in": "query",
            "required": false,
            "description": "Omitted means null; an empty value remains an empty string, preserving the canonical directory query.",
            "schema": {
              "type": "string",
              "maxLength": 512
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Three identity fields (4 KiB limit).",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileIdentityDto"
                }
              }
            }
          },
          "400": {
            "description": "INVALID_SESSION_MODE or INVALID_REQUEST",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "UNAUTHORIZED: absent, duplicate or wrong read credential",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "FORBIDDEN: credential does not authorize another path or method",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "PROFILE_IDENTITIES_UNAVAILABLE: owner failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "NOT_FOUND: canonical identity lookup returned Optional.empty.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/_internal/v1/accounts/identities/workspace": {
      "get": {
        "operationId": "userIdsByWorkspace",
        "security": [
          {
            "profileIdentitiesRead": []
          }
        ],
        "parameters": [
          {
            "name": "X-MyScoutee-Session-Mode",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "REAL",
                "DEMO"
              ]
            }
          },
          {
            "name": "groupId",
            "in": "query",
            "required": false,
            "description": "Omitted means null; an empty value remains an empty string, preserving the canonical directory query.",
            "schema": {
              "type": "string",
              "maxLength": 512
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Profile IDs only (2 MiB limit); preserves canonical order and empty-list semantics.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileIds"
                }
              }
            }
          },
          "400": {
            "description": "INVALID_SESSION_MODE or INVALID_REQUEST",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "UNAUTHORIZED: absent, duplicate or wrong read credential",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "FORBIDDEN: credential does not authorize another path or method",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "PROFILE_IDENTITIES_UNAVAILABLE: owner failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/_internal/v1/accounts/identities/profile/first": {
      "get": {
        "operationId": "findFirstProfileIdentity",
        "security": [
          {
            "profileIdentitiesRead": []
          }
        ],
        "parameters": [
          {
            "name": "X-MyScoutee-Session-Mode",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "REAL",
                "DEMO"
              ]
            }
          },
          {
            "name": "userId",
            "in": "query",
            "required": false,
            "description": "Omitted means null; an empty value remains an empty string, preserving the canonical directory query.",
            "schema": {
              "type": "string",
              "maxLength": 512
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Three identity fields (4 KiB limit).",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileIdentityDto"
                }
              }
            }
          },
          "400": {
            "description": "INVALID_SESSION_MODE or INVALID_REQUEST",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "UNAUTHORIZED: absent, duplicate or wrong read credential",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "FORBIDDEN: credential does not authorize another path or method",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "PROFILE_IDENTITIES_UNAVAILABLE: owner failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "NOT_FOUND: canonical identity lookup returned Optional.empty.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/_internal/v1/accounts/identities/exists": {
      "get": {
        "operationId": "existsNotDeleted",
        "security": [
          {
            "profileIdentitiesRead": []
          }
        ],
        "parameters": [
          {
            "name": "X-MyScoutee-Session-Mode",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "REAL",
                "DEMO"
              ]
            }
          },
          {
            "name": "userId",
            "in": "query",
            "required": false,
            "description": "Omitted means null; an empty value remains an empty string, preserving the canonical directory query.",
            "schema": {
              "type": "string",
              "maxLength": 512
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Whether a matching profile has not been deleted; false is a successful domain result.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileExists"
                }
              }
            }
          },
          "400": {
            "description": "INVALID_SESSION_MODE or INVALID_REQUEST",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "UNAUTHORIZED: absent, duplicate or wrong read credential",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "FORBIDDEN: credential does not authorize another path or method",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "PROFILE_IDENTITIES_UNAVAILABLE: owner failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "profileIdentitiesRead": {
        "type": "http",
        "scheme": "bearer",
        "description": "Dedicated profile-identities read secret; at least 256 random bits. Never expose to browsers."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "code"
        ],
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "INVALID_REQUEST",
              "INVALID_SESSION_MODE",
              "UNAUTHORIZED",
              "FORBIDDEN",
              "NOT_FOUND",
              "PROFILE_IDENTITIES_UNAVAILABLE"
            ]
          }
        }
      },
      "ProfileIdentityDto": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "userId",
          "accountUserId",
          "workspaceGroupId"
        ],
        "properties": {
          "userId": {
            "type": [
              "string",
              "null"
            ]
          },
          "accountUserId": {
            "type": [
              "string",
              "null"
            ]
          },
          "workspaceGroupId": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "ProfileIds": {
        "type": "array",
        "items": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "ProfileExists": {
        "type": "boolean"
      }
    }
  }
}
