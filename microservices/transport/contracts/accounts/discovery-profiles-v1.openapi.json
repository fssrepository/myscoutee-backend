{
  "openapi": "3.1.0",
  "info": {
    "title": "MyScoutee discovery-profiles",
    "version": "1.0.0",
    "description": "Existing native account queries restricted to discovery display, coordinates and language matching. Shared by groups, campaigns, community service listings and feed; preserves distance/filter logic without exporting devices, finances or integration settings. Mandatory REAL/DEMO and explicit job scope; no-store, 2 MiB request and 8 MiB response bounds, no retries."
  },
