{
  "openapi": "3.1.0",
  "info": {
    "title": "MyScoutee profile cards",
    "version": "1.0.0",
    "description": "Existing account-owned queryUsersByIds game-card presentation. Native normalization, deduplication, usability checks, ordering and field mapping are retained. Only explicitly listed service consumers; REAL/DEMO is mandatory. Bounded 4096-ID / 1 MiB requests and 8 MiB replies; no truncation or retries. Full profile presentation uses the same owner and UserDto with impressions; supplied IDs are fetched once and rendered through native toUserDto. This additional endpoint has not yet been tested."
  },
  "paths": {
    "/_internal/v1/accounts/profile-cards": {
      "post": {
        "operationId": "queryUsersByIds",
        "security": [
          {
            "serviceCapability": []
          }
        ],
        "parameters": [
          {
            "name": "X-MyScoutee-Session-Mode",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "REAL",
                "DEMO"
              ]
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IdsQuery"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Account-owned rating facts with canonical activity visibility",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/UserDto"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid request or session mode",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing/wrong service capability",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Unsupported method",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Body exceeds 1 MiB",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "JSON content type required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Account owner unavailable; not an empty profile list",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
