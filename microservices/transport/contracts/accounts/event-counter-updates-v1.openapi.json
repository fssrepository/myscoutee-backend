{
  "openapi": "3.1.0",
  "info": {
    "title": "Event counter replacements",
    "version": "1.0.0",
    "description": "The events owner supplies computed invitation/event/hosting counts. The accounts owner loads its own documents and applies the native merge and equality rules. Bounded batches, REAL/DEMO isolation, no blind retry after unknown write outcomes."
  },
  "paths": {
    "/_internal/v1/accounts/event-counter-updates": {
      "post": {
        "security": [
          {
            "serviceCapability": []
          }
        ],
        "parameters": [
          {
            "in": "header",
            "name": "X-MyScoutee-Session-Mode",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "REAL",
                "DEMO"
              ]
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Request"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Result"
                }
              }
            }
          },
          "400": {
            "description": "Rejected or unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Rejected or unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Rejected or unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Rejected or unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "Rejected or unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Rejected or unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "serviceCapability": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Request": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "changes"
        ],
        "properties": {
          "changes": {
            "type": "array",
            "maxItems": 512,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "userId",
                "invitations",
                "events",
                "hosting"
              ],
              "properties": {
                "userId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "invitations": {
                  "type": "integer",
                  "minimum": 0
                },
                "events": {
                  "type": "integer",
                  "minimum": 0
                },
                "hosting": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      },
      "Result": {
        "type": "object",
        "required": [
          "changed"
        ],
        "additionalProperties": false,
        "properties": {
          "changed": {
            "type": "integer",
            "minimum": 0,
            "maximum": 512
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "code"
        ],
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          }
        }
      }
    }
  }
}
