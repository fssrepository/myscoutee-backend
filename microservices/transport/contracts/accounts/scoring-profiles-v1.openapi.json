            ]
          },
          "value": {
            "type": [
              "string",
              "null"
            ]
          },
          "privacy": {
            "type": [
              "string",
              "null"
            ]
          },
          "options": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      },
      "ImpressionsDto": {
        "type": [
          "object",
          "null"
        ],
        "additionalProperties": false,
        "properties": {
          "host": {
            "$ref": "#/components/schemas/ImpressionSectionDto"
          },
          "member": {
            "$ref": "#/components/schemas/ImpressionSectionDto"
          }
        }
      },
      "ImpressionSectionDto": {
        "type": [
          "object",
          "null"
        ],
        "additionalProperties": false,
        "properties": {
          "unreadCount": {
            "type": [
              "integer",
              "null"
            ]
          },
          "averageRating": {
            "type": [
              "number",
              "null"
            ]
          },
          "peopleMet": {
            "type": [
              "integer",
              "null"
            ]
          },
          "totalEvents": {
            "type": [
              "integer",
              "null"
            ]
          },
          "repeatCount": {
            "type": [
              "integer",
              "null"
            ]
          },
          "noShowCount": {
            "type": [
              "integer",
              "null"
            ]
          },
          "vibeBadges": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "personalityBadges": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "personalityTraits": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "$ref": "#/components/schemas/TraitDto"
            }
          },
          "categoryBadges": {
