{
  "openapi": "3.1.0",
  "info": {
    "title": "MyScoutee stored scoring profiles",
    "version": "1.0.0",
    "description": "Existing account-owned single/batch selection of stored affinity inputs. Immutable typed scoring values preserve nulls, order and native nested profile/impression facts. No account auth, devices, payments or integration settings. Capability restricted to account owner and affinity consumers; mandatory REAL/DEMO. Requests bounded to 4096 identifiers / 2 MiB, replies to 16 MiB without truncation. No retries."
  },
  "paths": {
    "/_internal/v1/accounts/scoring-profiles/single": {
      "post": {
        "operationId": "findByUserId",
        "security": [
          {
            "serviceCapability": []
          }
        ],
        "parameters": [
          {
            "name": "X-MyScoutee-Session-Mode",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "REAL",
                "DEMO"
              ]
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SingleQuery"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Canonical owner result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SingleResult"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or session mode",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong service capability",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Request exceeds byte limit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "JSON content type required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Owner unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/_internal/v1/accounts/scoring-profiles/batch": {
      "post": {
        "operationId": "findByUserIdIn",
        "security": [
          {
            "serviceCapability": []
          }
        ],
        "parameters": [
          {
            "name": "X-MyScoutee-Session-Mode",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "REAL",
                "DEMO"
              ]
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BatchQuery"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Canonical owner result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ScoringProfileDto"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or session mode",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong service capability",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Request exceeds byte limit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "JSON content type required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Owner unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "serviceCapability": {
        "type": "http",
        "scheme": "bearer",
        "description": "Dedicated profile-summary read credential; server-only, at least 256 random bits."
      }
    },
    "schemas": {
      "SingleQuery": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "userId": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 512
          }
        }
      },
      "BatchQuery": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "userIds"
        ],
        "properties": {
          "userIds": {
            "type": "array",
            "maxItems": 4096,
            "items": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 512
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "INVALID_REQUEST",
              "INVALID_SESSION_MODE",
              "UNAUTHORIZED",
              "FORBIDDEN",
              "QUERY_TOO_LARGE",
              "INVALID_CONTENT_TYPE",
              "PROFILE_SUMMARIES_UNAVAILABLE"
            ]
          }
        }
      },
      "SingleResult": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "resolved",
          "value"
        ],
        "properties": {
          "resolved": {
            "const": true
          },
          "value": {
            "$ref": "#/components/schemas/ScoringProfileDto"
          }
        }
      },
      "ScoringProfileDto": {
        "type": [
          "object",
          "null"
        ],
        "additionalProperties": false,
        "properties": {
          "userId": {
            "type": [
              "string",
              "null"
            ]
          },
          "workspaceGroupId": {
            "type": [
              "string",
              "null"
            ]
          },
          "syncKey": {
            "type": [
              "string",
              "null"
            ]
          },
          "city": {
            "type": [
              "string",
              "null"
            ]
          },
          "physique": {
            "type": [
              "string",
              "null"
            ]
          },
          "languages": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "horoscope": {
            "type": [
              "string",
              "null"
            ]
          },
          "gender": {
            "type": [
              "string",
              "null"
            ]
          },
          "hostTier": {
            "type": [
              "string",
              "null"
            ]
          },
          "traitLabel": {
            "type": [
              "string",
              "null"
            ]
          },
          "headline": {
            "type": [
              "string",
              "null"
            ]
          },
          "about": {
            "type": [
              "string",
              "null"
            ]
          },
          "age": {
            "type": [
              "integer",
              "null"
            ]
          },
          "height": {
            "type": [
              "string",
              "null"
            ]
          },
          "completion": {
            "type": [
              "integer",
              "null"
            ]
          },
          "affinity": {
            "type": [
              "number",
              "null"
            ]
          },
          "locationCoordinates": {
            "$ref": "#/components/schemas/CoordinatesDto"
          },
          "profileDetails": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "$ref": "#/components/schemas/DetailGroupDto"
            }
          },
          "impressions": {
            "$ref": "#/components/schemas/ImpressionsDto"
          }
        }
      },
      "CoordinatesDto": {
        "type": [
          "object",
          "null"
        ],
        "additionalProperties": false,
        "properties": {
          "latitude": {
            "type": [
              "number",
              "null"
            ]
          },
          "longitude": {
            "type": [
              "number",
              "null"
            ]
          }
        }
      },
      "DetailGroupDto": {
        "type": [
          "object",
          "null"
        ],
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": [
              "string",
              "null"
            ]
          },
          "rows": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "$ref": "#/components/schemas/DetailRowDto"
            }
          }
        }
      },
      "DetailRowDto": {
        "type": [
          "object",
          "null"
        ],
        "additionalProperties": false,
        "properties": {
          "labelKey": {
            "type": [
              "string",
