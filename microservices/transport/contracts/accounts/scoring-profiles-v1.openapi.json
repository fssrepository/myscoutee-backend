              "array",
              "null"
            ],
            "items": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      },
      "TraitDto": {
        "type": [
          "object",
          "null"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": [
              "string",
              "null"
            ]
          },
          "label": {
            "type": [
              "string",
              "null"
            ]
          },
          "percent": {
            "type": [
              "integer",
              "null"
            ]
          },
          "evidenceCount": {
            "type": [
              "integer",
              "null"
            ]
          },
          "lastRatedAtIso": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
