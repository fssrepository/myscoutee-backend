  "components": {
    "securitySchemes": {
      "serviceCapability": {
        "type": "http",
        "scheme": "bearer",
        "description": "Dedicated profile-summary read credential; server-only, at least 256 random bits."
      }
    },
    "schemas": {
      "ProfileQuery": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "profileId"
        ],
        "properties": {
          "profileId": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 512
          }
        }
      },
      "RefreshCommand": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ids"
        ],
        "properties": {
          "ids": {
            "type": "array",
            "maxItems": 4096,
            "items": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 512
            }
          }
        }
      },
      "Ids": {
        "type": "array",
        "items": {
          "type": "string",
          "maxLength": 512
        }
      },
      "Receipt": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "completed"
        ],
        "properties": {
          "completed": {
            "const": true
          }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "type": "string"
          }
        }
      }
