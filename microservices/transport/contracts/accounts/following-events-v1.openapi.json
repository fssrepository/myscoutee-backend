{
  "openapi": "3.1.0",
  "info": {
    "title": "Stored following state",
    "version": "1.0.0",
    "description": "Accounts owns organizer IDs and recomputes following counters with the existing compare-and-set logic. Event eligibility is the canonical local pure rule, not another RPC. IDs-only requests; 4096 IDs / 2 MiB; 2 MiB reads and 16 KiB acknowledgments. No automatic retry. Owner conflict remains 409."
  },
  "paths": {
    "/_internal/v1/accounts/following/organizers": {
      "post": {
        "operationId": "organizers",
        "security": [
          {
            "serviceCapability": []
          }
        ],
        "parameters": [
          {
            "name": "X-MyScoutee-Session-Mode",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "REAL",
                "DEMO"
              ]
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProfileQuery"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Canonical owner result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ids"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or session mode",
