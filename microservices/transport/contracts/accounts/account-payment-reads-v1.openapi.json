{
  "openapi": "3.1.0",
  "info": {
    "title": "MyScoutee account-payment-reads",
    "version": "1.0.0",
    "description": "Account-owned stored payment summary and non-deleted receipt participants. Reuses native profile queries. Only payments, assets and the account owner receive this read capability. No device, integration, full-profile or provider credential data. REAL/DEMO context is mandatory. Summary absence is an explicit successful owner result; transport failures never become zero balances. Summary request capped at 16 KiB, participant request at 4096 IDs / 2 MiB; responses capped at 2 MiB. No retries."
  },
  "paths": {
    "/_internal/v1/accounts/payment-reads/summary": {
      "post": {
        "operationId": "paymentSummary",
        "security": [
          {
            "serviceCapability": []
          }
        ],
        "parameters": [
          {
            "name": "X-MyScoutee-Session-Mode",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "REAL",
                "DEMO"
              ]
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SummaryQuery"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Canonical owner result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SummaryResult"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or session mode",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong service capability",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Request exceeds byte limit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "JSON content type required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Owner unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/_internal/v1/accounts/payment-reads/participants": {
      "post": {
        "operationId": "paymentParticipants",
        "security": [
          {
            "serviceCapability": []
          }
        ],
        "parameters": [
          {
            "name": "X-MyScoutee-Session-Mode",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "REAL",
                "DEMO"
              ]
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ParticipantsQuery"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Canonical owner result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ParticipantsResult"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or session mode",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong service capability",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Request exceeds byte limit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "JSON content type required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Owner unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/_internal/v1/accounts/payment-reads/totals": {
      "post": {
        "operationId": "paymentTotals",
        "security": [
          {
            "serviceCapability": []
          }
        ],
        "parameters": [
          {
            "name": "X-MyScoutee-Session-Mode",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "REAL",
                "DEMO"
              ]
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SummaryQuery"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Canonical owner result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TotalsResult"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or session mode",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong service capability",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Request exceeds byte limit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "JSON content type required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Owner unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "serviceCapability": {
        "type": "http",
        "scheme": "bearer",
        "description": "Dedicated account-payment read credential; server-only, at least 256 random bits."
      }
    },
    "schemas": {
      "SummaryQuery": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "userId": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 512
          }
        }
      },
      "ParticipantsQuery": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ids"
        ],
        "properties": {
          "ids": {
            "type": "array",
            "maxItems": 4096,
            "items": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 512
            }
          }
        }
      },
      "SummaryResult": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "resolved"
        ],
        "properties": {
          "resolved": {
            "const": true
          },
          "value": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "properties": {
              "spent": {
                "type": [
                  "object",
                  "null"
                ],
                "additionalProperties": {
                  "type": [
                    "number",
                    "null"
                  ]
                }
              },
              "income": {
                "type": [
                  "object",
                  "null"
                ],
                "additionalProperties": {
                  "type": [
                    "number",
                    "null"
                  ]
                }
              },
              "pendingRefunds": {
                "type": [
                  "integer",
                  "null"
                ]
              }
            }
          }
        }
      },
      "ParticipantsResult": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "userId": {
              "type": [
                "string",
                "null"
              ]
            },
            "workspaceGroupId": {
              "type": [
                "string",
                "null"
              ]
            },
            "name": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "INVALID_REQUEST",
              "INVALID_SESSION_MODE",
              "UNAUTHORIZED",
              "FORBIDDEN",
              "QUERY_TOO_LARGE",
              "INVALID_CONTENT_TYPE",
              "ACCOUNT_PAYMENT_READS_UNAVAILABLE"
            ]
          }
        }
      },
      "TotalsResult": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "resolved",
          "value"
        ],
        "properties": {
          "resolved": {
            "const": true
          },
          "value": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "properties": {
              "outgoing": {
                "type": "object",
                "additionalProperties": {
                  "type": [
                    "number",
                    "null"
                  ]
                }
              },
              "incoming": {
                "type": "object",
                "additionalProperties": {
                  "type": [
                    "number",
                    "null"
                  ]
                }
              },
              "all": {
                "type": "object",
                "additionalProperties": {
                  "type": [
                    "number",
                    "null"
                  ]
                }
              }
            },
            "required": [
              "outgoing",
              "incoming",
              "all"
            ]
          }
        }
      }
    }
  }
}
