{
  "openapi": "3.1.0",
  "info": {
    "title": "MyScoutee rating-page-reads",
    "version": "1.0.0",
    "description": "Typed calls to the existing RatingPageReads owner. Native validation, queries, state transitions and scheduler behavior retained. REAL/DEMO and explicit job scope; no-store. 2 MiB request / 8 MiB response bounds; no automatic retries."
  },
  "paths": {
    "/_internal/v1/affinity/rating-page-reads/page": {
      "post": {
        "operationId": "rating_page_reads_page",
        "security": [
          {
            "serviceCapability": []
          }
        ],
        "parameters": [
          {
            "name": "X-MyScoutee-Session-Mode",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "REAL",
                "DEMO"
              ]
            }
          },
          {
            "name": "X-MyScoutee-Actor-Delegation",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Operation/body/mode-bound RSA proof; request user must equal verified actor."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Query"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Canonical owner result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActivityRatePageResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or session mode",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong service capability",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Request exceeds byte limit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "JSON content type required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Canonical owner unavailable; operation outcome is not assumed successful",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Native owner rejection",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Native owner rejection",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
