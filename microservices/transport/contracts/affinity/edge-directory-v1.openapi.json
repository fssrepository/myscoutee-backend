{
  "openapi": "3.1.0",
  "info": {
    "title": "MyScoutee internal affinity edge directory",
    "version": "1.0.0",
    "description": "The two canonical directory reads. Dedicated service credential with REAL/DEMO context, no actor authority or writes. Exact seven-field view; private edge evidence never crosses this boundary. Read response limit 2 MiB; batch limit 4096 IDs and 1 MiB."
  },
  "paths": {
    "/_internal/v1/affinity/edges/all": {
      "get": {
        "operationId": "readAffinityEdgesAll",
        "security": [
          {
            "edgeDirectoryRead": []
          }
        ],
        "parameters": [
          {
            "name": "X-MyScoutee-Session-Mode",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "REAL",
                "DEMO"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Canonical result",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Edges"
                }
              }
            }
          },
          "400": {
            "description": "Typed error; never a fallback",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Typed error; never a fallback",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Typed error; never a fallback",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "EDGE_DIRECTORY_UNAVAILABLE: canonical directory failed",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/_internal/v1/affinity/edges/relevant": {
      "post": {
        "operationId": "readAffinityEdgesRelevant",
        "security": [
          {
            "edgeDirectoryRead": []
          }
        ],
        "parameters": [
          {
            "name": "X-MyScoutee-Session-Mode",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "REAL",
                "DEMO"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Canonical result",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Edges"
                }
              }
            }
          },
          "400": {
            "description": "Typed error; never a fallback",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Typed error; never a fallback",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Typed error; never a fallback",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "EDGE_DIRECTORY_UNAVAILABLE: canonical directory failed",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Typed error; never a fallback",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "Typed error; never a fallback",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "ids"
                ],
                "properties": {
                  "ids": {
                    "type": [
                      "array",
                      "null"
                    ],
                    "maxItems": 4096,
                    "items": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "maxLength": 512
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "edgeDirectoryRead": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "INVALID_REQUEST",
              "INVALID_CONTENT_TYPE",
              "QUERY_TOO_LARGE",
              "INVALID_SESSION_MODE",
              "UNAUTHORIZED",
              "FORBIDDEN",
              "EDGE_DIRECTORY_UNAVAILABLE"
            ]
          }
        }
      },
      "Edges": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "pairKey",
            "leftUserId",
            "rightUserId",
            "affinityScore",
            "edgeWeight",
            "updatedDate"
          ],
          "properties": {
            "id": {
              "type": [
                "string",
                "null"
              ]
            },
            "pairKey": {
              "type": [
                "string",
                "null"
              ]
            },
            "leftUserId": {
              "type": [
                "string",
                "null"
              ]
            },
            "rightUserId": {
              "type": [
                "string",
                "null"
              ]
            },
            "affinityScore": {
              "type": [
                "number",
                "null"
              ]
            },
            "edgeWeight": {
              "type": [
                "number",
                "null"
              ]
            },
            "updatedDate": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      }
    }
  }
}
