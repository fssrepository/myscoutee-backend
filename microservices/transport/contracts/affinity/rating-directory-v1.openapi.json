{
  "openapi": "3.1.0",
  "info": {
    "title": "MyScoutee internal rating directory",
    "version": "1.0.0",
    "description": "Four canonical rating directory reads with dedicated service credential and REAL/DEMO context. No writes or delegated actor authority. Only existing RatingView fields; supplemental actor snapshots remain private. Batch limit 4096 IDs / 1 MiB; response limit 2 MiB."
  },
