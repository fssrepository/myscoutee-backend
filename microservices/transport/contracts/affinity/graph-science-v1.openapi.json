{
  "openapi": "3.1.0",
  "info": {
    "title": "MyScoutee graph-science",
    "version": "1.0.0",
    "description": "Typed calls to the existing GraphScience owner. Native validation, queries, state transitions and scheduler behavior retained. REAL/DEMO and explicit job scope; no-store. 2 MiB request / 8 MiB response bounds; no automatic retries."
  },
  "paths": {
    "/_internal/v1/affinity/graph-science/refresh": {
      "post": {
        "operationId": "graph_science_refresh",
        "security": [
          {
            "serviceCapability": []
          }
        ],
        "parameters": [
          {
            "name": "X-MyScoutee-Session-Mode",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "REAL",
                "DEMO"
              ]
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Query"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Canonical owner result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GraphScienceResult"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or session mode",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong service capability",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Request exceeds byte limit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "JSON content type required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Canonical owner unavailable; operation outcome is not assumed successful",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Native owner rejection",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Native owner rejection",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Native owner rejection",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "serviceCapability": {
        "type": "http",
        "scheme": "bearer",
        "description": "Dedicated graph-science capability for administration."
      }
    },
    "schemas": {
      "Query": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "scope": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Scope"
              },
              {
                "type": "null"
              }
            ]
          },
          "key": {
            "type": [
              "string",
              "null"
            ]
          },
          "existing": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": {
                "type": [
                  "integer",
                  "null"
                ]
              }
            }
          }
        },
        "required": [
          "scope"
        ]
      },
      "Scope": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "active": {
            "type": "boolean"
          },
          "groupId": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "active"
        ]
      },
      "GraphScienceResult": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "healthScore": {
            "type": "integer"
          },
          "healthLabelKey": {
            "type": [
              "string",
              "null"
            ]
          },
          "insightKey": {
            "type": [
              "string",
              "null"
            ]
          },
          "metrics": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": {
              "type": [
                "integer",
                "null"
              ]
            }
          },
          "bridgeUsers": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": {
              "type": [
                "integer",
                "null"
              ]
            }
          },
          "communities": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": {
              "type": [
                "integer",
                "null"
              ]
            }
          },
          "signals": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": {
              "type": [
                "integer",
                "null"
              ]
            }
          },
          "dailyGraphActivity": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": {
                "type": [
                  "integer",
                  "null"
                ]
              }
            }
          }
        },
        "required": [
          "healthScore"
        ]
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "enum": [
              "INVALID_REQUEST",
              "INVALID_SESSION_MODE",
              "UNAUTHORIZED",
              "FORBIDDEN",
              "QUERY_TOO_LARGE",
              "INVALID_CONTENT_TYPE",
              "OWNER_REJECTED",
              "GRAPH_SCIENCE_UNAVAILABLE"
            ]
          }
        },
        "required": [
          "code"
        ]
      }
    }
  }
}
