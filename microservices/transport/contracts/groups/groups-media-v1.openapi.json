{
  "openapi": "3.1.0",
  "info": {
    "title": "MyScoutee internal group media visibility read",
    "version": "1.0.0",
    "description": "Typed GroupMediaVisibility contract. Returns only lifecycleStatus for media policy evaluation. A dedicated service credential grants this read only; it does not establish user authority or make the media-access decision. REAL/DEMO is mandatory. No retries or redirects. HTTPS except explicit isolated-lab HTTP."
  },
  "paths": {
    "/_internal/v1/groups/media-visibility": {
      "get": {
        "operationId": "getGroupMediaVisibility",
        "security": [
          {
            "groupsMediaRead": []
          }
        ],
        "parameters": [
          {
            "name": "X-MyScoutee-Session-Mode",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "REAL",
                "DEMO"
              ]
            }
          },
          {
            "name": "id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Minimal group lifecycle projection; maximum response 4 KiB.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GroupMediaVisibilityDto"
                }
              }
            }
          },
          "400": {
            "description": "INVALID_SESSION_MODE or INVALID_REQUEST",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "UNAUTHORIZED: absent, duplicate or wrong read credential",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "FORBIDDEN: credential does not authorize another path or method",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "GROUP_VISIBILITY_UNAVAILABLE: owner failed; persistence details are not exposed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "NOT_FOUND: the canonical directory has no group for this ID in the selected session mode.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "groupsMediaRead": {
        "type": "http",
        "scheme": "bearer",
        "description": "Dedicated internal group-media read credential of at least 256 random bits. Never distribute to browsers or put in URLs."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "code"
        ],
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "INVALID_SESSION_MODE",
              "INVALID_REQUEST",
              "UNAUTHORIZED",
              "FORBIDDEN",
              "NOT_FOUND",
              "GROUP_VISIBILITY_UNAVAILABLE"
            ]
          }
        }
      },
      "GroupMediaVisibilityDto": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "lifecycleStatus"
        ],
        "properties": {
          "lifecycleStatus": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
