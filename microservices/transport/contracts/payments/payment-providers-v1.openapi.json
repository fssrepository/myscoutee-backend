{
  "openapi": "3.1.0",
  "info": {
    "title": "MyScoutee payment-providers",
    "version": "1.0.0",
    "description": "Canonical enabled provider catalog and validation against the exact caller-supplied catalog snapshot. No provider credentials or deployment settings are exposed. Native empty selection stays null; unavailable selection restores IllegalArgumentException. Request/list response 1 MiB; validation response 16 KiB. Service-scoped read capability; REAL/DEMO context preserved. Existing bounded transport, no automatic retry, no fallback after owner failure, Cache-Control: no-store."
  },
  "paths": {
    "/_internal/v1/payments/providers": {
      "get": {
        "operationId": "payment_providers_providers",
        "security": [
          {
            "serviceCapability": []
          }
        ],
        "parameters": [
          {
            "name": "X-MyScoutee-Session-Mode",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "REAL",
                "DEMO"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Canonical owner result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Catalog"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or session mode",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong service capability",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Owner unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/_internal/v1/payments/providers/validate": {
      "post": {
        "operationId": "payment_providers_validate",
        "security": [
          {
            "serviceCapability": []
          }
        ],
        "parameters": [
          {
            "name": "X-MyScoutee-Session-Mode",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "REAL",
                "DEMO"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Canonical owner result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Result"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or session mode",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong service capability",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Owner unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Request exceeds byte limit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "JSON content type required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Query"
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "serviceCapability": {
        "type": "http",
        "scheme": "bearer",
        "description": "Dedicated service capability for this contract; never expose to browsers."
      }
    },
    "schemas": {
      "Catalog": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 512
            },
            "label": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 4096
            },
            "logoUrl": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 8192
            },
            "logoAlt": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 4096
            },
            "palette": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 4096
            }
          },
          "required": [
            "id",
            "label",
            "logoUrl",
            "logoAlt",
            "palette"
          ]
        }
      },
      "Query": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "providerId": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 512
          },
          "availableProviders": {
            "type": [
              "array",
              "null"
            ],
            "maxItems": 256,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 512
                },
                "label": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 4096
                },
                "logoUrl": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 8192
                },
                "logoAlt": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 4096
                },
                "palette": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 4096
                }
              },
              "required": [
                "id",
                "label",
                "logoUrl",
                "logoAlt",
                "palette"
              ]
            }
          }
        },
        "required": []
      },
      "Result": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "resolved": {
            "const": true
          },
          "providerId": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "resolved"
        ]
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "INVALID_REQUEST",
              "INVALID_SESSION_MODE",
              "UNAUTHORIZED",
              "FORBIDDEN",
              "QUERY_TOO_LARGE",
              "INVALID_CONTENT_TYPE",
              "OWNER_REJECTED",
              "PAYMENT_PROVIDERS_UNAVAILABLE"
            ]
          }
        },
        "required": [
          "code"
        ]
      }
    }
  }
}
