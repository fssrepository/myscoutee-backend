{
  "openapi": "3.1.0",
  "info": {
    "title": "MyScoutee payment-refunds",
    "version": "1.0.0",
    "description": "Typed calls to the existing PaymentRefunds owner. Native validation, queries, state transitions and scheduler behavior retained. REAL/DEMO and explicit job scope; no-store. 2 MiB request / 8 MiB response bounds; no automatic retries. Existing changed-terms refund request requires a signed actor matching the request; owner still verifies payer identity/eligibility. Unknown outcome does not authorize compensation."
  },
  "paths": {
    "/_internal/v1/payments/payment-refunds/changed-terms": {
      "post": {
        "operationId": "payment_refunds_changed_terms",
        "security": [
          {
            "serviceCapability": []
          }
        ],
        "parameters": [
          {
            "name": "X-MyScoutee-Session-Mode",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "REAL",
                "DEMO"
              ]
            }
          },
          {
            "name": "X-MyScoutee-Actor-Delegation",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Operation/body/mode-bound RSA proof; request user must equal verified actor."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
