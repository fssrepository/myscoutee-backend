{
  "openapi": "3.1.0",
  "info": {
    "title": "MyScoutee exchange-rate-refresh",
    "version": "1.0.0",
    "description": "Invoke the existing exchange-rate worker with its original actor and start timestamp. The receipt means the worker returned; the native notification registry contains completed/failed/skipped business status. No automatic retry. REAL/DEMO and explicit job scope preserved. Notifications-only capability, one concurrent manual execution per owner instance. 16 KiB requests; configured 10-minute request window, maximum 15 minutes. Distributed restart/acknowledgment ownership remains milestone 16."
  },
  "paths": {
    "/_internal/v1/payments/exchange-rate-refresh/run": {
      "post": {
        "operationId": "exchange_rate_refresh_run",
        "security": [
          {
            "serviceCapability": []
          }
        ],
        "parameters": [
          {
            "name": "X-MyScoutee-Session-Mode",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "REAL",
                "DEMO"
              ]
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Command"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Worker returned; inspect canonical run state for business status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Receipt"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or session mode",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong service capability",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Request exceeds byte limit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "JSON content type required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Canonical owner unavailable; operation outcome is not assumed successful",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "serviceCapability": {
        "type": "http",
        "scheme": "bearer",
        "description": "Notifications-only exchange-rate-refresh command capability."
      }
    },
    "schemas": {
      "Command": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "active": {
            "type": "boolean"
          },
          "groupId": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 512
          },
          "actor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "startedAt": {
            "type": "string"
          }
        },
        "required": [
          "active",
          "actor",
          "startedAt"
        ]
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "INVALID_REQUEST",
              "INVALID_SESSION_MODE",
              "UNAUTHORIZED",
              "FORBIDDEN",
              "QUERY_TOO_LARGE",
              "INVALID_CONTENT_TYPE",
              "BUSY",
              "REFRESH_OUTCOME_UNKNOWN"
            ]
          }
        },
        "required": [
          "code"
        ]
      },
      "Receipt": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "returned": {
            "const": true
          }
        },
        "required": [
          "returned"
        ]
      }
    }
  }
}
