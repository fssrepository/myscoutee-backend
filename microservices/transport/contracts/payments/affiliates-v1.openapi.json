  "components": {
    "securitySchemes": {
      "serviceCapability": {
        "type": "http",
        "scheme": "bearer",
        "description": "Dedicated affiliates capability for integrations."
      }
    },
    "schemas": {
      "Query": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "scope": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Scope"
              },
              {
                "type": "null"
              }
            ]
          },
          "owner": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "scope"
        ]
      },
      "Scope": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "active": {
            "type": "boolean"
          },
          "groupId": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "active"
        ]
      },
      "Link": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "resolved": {
            "const": true
          },
          "value": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "resolved"
        ]
      },
      "AffiliateSummaryDto": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "url": {
            "type": [
              "string",
              "null"
            ]
          },
          "registered": {
            "type": "integer"
          },
          "revenue": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AffiliateRevenueDto"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "registered"
        ]
      },
      "AffiliateRevenueDto": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "currencies": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/AffiliateCurrencyRevenueDto"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "purchases": {
            "type": "integer"
          },
          "eventBookings": {
            "type": "integer"
          },
          "euroSummary": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Summary"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "purchases",
          "eventBookings"
        ]
      },
      "AffiliateCurrencyRevenueDto": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "gross": {
            "type": "number"
          },
          "refunded": {
            "type": "number"
          },
          "net": {
            "type": "number"
          }
        },
        "required": [
          "gross",
          "refunded",
          "net"
        ]
      },
      "Summary": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "outgoing": {
            "type": "number"
          },
          "incoming": {
            "type": "number"
          },
          "gross": {
            "type": "number"
          },
          "refunded": {
            "type": "number"
          },
          "net": {
            "type": "number"
          },
          "missingRates": {
            "type": "integer"
          },
          "currency": {
            "type": [
              "string",
              "null"
            ]
          },
          "currencies": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "required": [
          "outgoing",
          "incoming",
          "gross",
          "refunded",
          "net",
          "missingRates"
        ]
      },
      "IntegrationParticipantSummaryDto": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "registered": {
            "type": "integer"
          },
          "imported": {
            "type": "integer"
          }
        },
        "required": [
          "registered",
          "imported"
        ]
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "enum": [
              "INVALID_REQUEST",
              "INVALID_SESSION_MODE",
              "UNAUTHORIZED",
              "FORBIDDEN",
              "QUERY_TOO_LARGE",
              "INVALID_CONTENT_TYPE",
              "OWNER_REJECTED",
              "AFFILIATES_UNAVAILABLE"
            ]
          }
        },
        "required": [
          "code"
        ]
      }
    }
  }
}
