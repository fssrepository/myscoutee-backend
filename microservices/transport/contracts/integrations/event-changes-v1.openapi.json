{
  "openapi": "3.1.0",
  "info": {
    "title": "MyScoutee event-changes",
    "version": "1.0.0",
    "description": "Event owner emits the thirteen existing integration event-change fields or the existing detached membership view. Native webhook selection/queue logic retained; no copied integration worker. REAL/DEMO and job scope preserved. 2 MiB request and 8 MiB response bounds; no-store. Cross-owner write/reply recovery remains milestone 16."
  },
