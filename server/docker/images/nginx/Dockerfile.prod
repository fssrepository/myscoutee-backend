FROM nginx:1.21.0

ARG TZ=Europe/Brussels
ENV TZ=${TZ}

RUN apt-get update && \
    apt-get install -y cron nano curl inotify-tools tzdata && \
    ln -snf /usr/share/zoneinfo/${TZ} /etc/localtime && \
    echo "${TZ}" > /etc/timezone && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

COPY docker/images/nginx/wait-for-it.sh /scripts/wait-for-it.sh
RUN chmod +x /scripts/wait-for-it.sh

COPY docker/images/nginx/wait-cmd.sh /scripts/wait-cmd.sh
RUN chmod +x /scripts/wait-cmd.sh

COPY docker/conf/nginx/nginx.conf /etc/nginx/nginx.conf
COPY docker/conf/nginx/conf/http /etc/nginx/conf.d
COPY docker/conf/nginx/conf/stream /etc/nginx/stream_conf.d
COPY docker/conf/nginx/app/myscoutee /usr/share/nginx/html

CMD ["bash", "-c", "/scripts/wait-cmd.sh"]
