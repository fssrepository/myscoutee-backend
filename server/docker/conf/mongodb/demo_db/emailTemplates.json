[
  {
    "_id": "email-template-promo-profile-completion-v1",
    "syncKey": "email-template-promo-profile-completion-v1",
    "templateKey": "promo-profile-completion-v1",
    "name": "Profile Completion Reminder",
    "description": "Promotional reminder for active users with incomplete profiles and no registered device.",
    "category": "promotional",
    "locale": "en",
    "enabled": true,
    "subjectTemplate": "@user_first_name, complete your profile and unlock stronger MyScoutee matches",
    "htmlTemplate": "<html>\n  <body style=\"margin:0;padding:0;background:#f4f7fb;font-family:Arial,sans-serif;color:#16304f;\">\n    <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" style=\"background:#f4f7fb;padding:24px 0;\">\n      <tr>\n        <td align=\"center\">\n          <table role=\"presentation\" width=\"640\" cellspacing=\"0\" cellpadding=\"0\" style=\"max-width:640px;background:#ffffff;border-radius:20px;overflow:hidden;border:1px solid #d9e5f4;\">\n            <tr>\n              <td style=\"background:linear-gradient(135deg,#f28b4b,#f6c36b);padding:28px 32px;color:#ffffff;\">\n                <div style=\"font-size:14px;letter-spacing:0.08em;text-transform:uppercase;opacity:0.88;\">MyScoutee</div>\n                <h1 style=\"margin:12px 0 0;font-size:30px;line-height:1.2;\">Finish your profile, @user_first_name</h1>\n              </td>\n            </tr>\n            <tr>\n              <td style=\"padding:32px;\">\n                <p style=\"margin:0 0 16px;font-size:16px;line-height:1.6;\">Your profile is currently <strong>@completion_percent%</strong> complete. A few thoughtful details can help MyScoutee surface better matches, more relevant activity suggestions, and stronger hosting opportunities around @user_city.</p>\n                <div style=\"background:#f6fbff;border:1px solid #d9ecff;border-radius:16px;padding:18px 20px;margin:0 0 22px;\">\n                  <div style=\"font-weight:700;margin-bottom:8px;\">What to improve next</div>\n                  <ul style=\"margin:0;padding-left:18px;line-height:1.7;\">\n                    <li>Add a sharper headline that explains your vibe in one sentence</li>\n                    <li>Complete your interests and values so suggestions feel more intentional</li>\n                    <li>Refresh one profile photo to make your profile feel current</li>\n                  </ul>\n                </div>\n                <div style=\"margin:24px 0 28px;\">\n                  <a href=\"@cta_url\" style=\"display:inline-block;background:#2f6fd6;color:#ffffff;text-decoration:none;padding:14px 22px;border-radius:999px;font-weight:700;\">@cta_label</a>\n                </div>\n                <p style=\"margin:0;color:#5f7694;font-size:13px;line-height:1.6;\">You are receiving this because your MyScoutee profile is active and we could not rely on a registered device for in-app promotional delivery.</p>\n              </td>\n            </tr>\n          </table>\n        </td>\n      </tr>\n    </table>\n  </body>\n</html>\n",
    "textTemplate": "MyScoutee\n\nFinish your profile, @user_first_name.\n\nYour profile is currently @completion_percent% complete. A few thoughtful details can help MyScoutee surface better matches and more relevant activity suggestions around @user_city.\n\nWhat to improve next:\n- Add a sharper headline that explains your vibe in one sentence\n- Complete your interests and values so suggestions feel more intentional\n- Refresh one profile photo to make your profile feel current\n\n@cta_label: @cta_url\n",
    "createdDate": "2026-04-27T00:00:00Z",
    "createdUser": "email-seed",
    "updatedDate": "2026-04-27T00:00:00Z",
    "updatedUser": "email-seed"
  },
  {
    "_id": "email-template-promo-first-host-event-v1",
    "syncKey": "email-template-promo-first-host-event-v1",
    "templateKey": "promo-first-host-event-v1",
    "name": "First Host Event Prompt",
    "description": "Promotional reminder for active members who have not hosted yet and are missing a registered device.",
    "category": "promotional",
    "locale": "en",
    "enabled": true,
    "subjectTemplate": "@user_first_name, host your first MyScoutee event this week",
    "htmlTemplate": "<html>\n  <body style=\"margin:0;padding:0;background:#f4f7fb;font-family:Arial,sans-serif;color:#16304f;\">\n    <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" style=\"background:#f4f7fb;padding:24px 0;\">\n      <tr>\n        <td align=\"center\">\n          <table role=\"presentation\" width=\"640\" cellspacing=\"0\" cellpadding=\"0\" style=\"max-width:640px;background:#ffffff;border-radius:20px;overflow:hidden;border:1px solid #d9e5f4;\">\n            <tr>\n              <td style=\"background:linear-gradient(135deg,#3ca88e,#85d0b5);padding:28px 32px;color:#ffffff;\">\n                <div style=\"font-size:14px;letter-spacing:0.08em;text-transform:uppercase;opacity:0.88;\">MyScoutee Hosting</div>\n                <h1 style=\"margin:12px 0 0;font-size:30px;line-height:1.2;\">Turn your social energy into an event</h1>\n              </td>\n            </tr>\n            <tr>\n              <td style=\"padding:32px;\">\n                <p style=\"margin:0 0 16px;font-size:16px;line-height:1.6;\">You already have enough profile depth to start hosting. A small, well-framed event in @user_city can help you meet people faster, shape the vibe yourself, and build stronger trust signals inside MyScoutee.</p>\n                <div style=\"background:#f7fdf9;border:1px solid #cfeedd;border-radius:16px;padding:18px 20px;margin:0 0 22px;\">\n                  <div style=\"font-weight:700;margin-bottom:8px;\">A simple first-event formula</div>\n                  <ul style=\"margin:0;padding-left:18px;line-height:1.7;\">\n                    <li>Pick one clear theme like brunch, walk, or court session</li>\n                    <li>Keep the group intentionally small for stronger chemistry</li>\n                    <li>Use one short description that tells people what to expect</li>\n                  </ul>\n                </div>\n                <div style=\"margin:24px 0 28px;\">\n                  <a href=\"@cta_url\" style=\"display:inline-block;background:#24775f;color:#ffffff;text-decoration:none;padding:14px 22px;border-radius:999px;font-weight:700;\">@cta_label</a>\n                </div>\n                <p style=\"margin:0;color:#5f7694;font-size:13px;line-height:1.6;\">This email is acting as a fallback because your profile is active but there is no registered device available for promotional delivery.</p>\n              </td>\n            </tr>\n          </table>\n        </td>\n      </tr>\n    </table>\n  </body>\n</html>\n",
    "textTemplate": "MyScoutee Hosting\n\nTurn your social energy into an event.\n\nYou already have enough profile depth to start hosting. A small, well-framed event in @user_city can help you meet people faster and shape the vibe yourself.\n\nA simple first-event formula:\n- Pick one clear theme like brunch, walk, or court session\n- Keep the group intentionally small for stronger chemistry\n- Use one short description that tells people what to expect\n\n@cta_label: @cta_url\n",
    "createdDate": "2026-04-27T00:00:00Z",
    "createdUser": "email-seed",
    "updatedDate": "2026-04-27T00:00:00Z",
    "updatedUser": "email-seed"
  },
  {
    "_id": "email-template-promo-country-broadcast-v1",
    "syncKey": "email-template-promo-country-broadcast-v1",
    "templateKey": "promo-country-broadcast-v1",
    "name": "Country Broadcast Promotion",
    "description": "Reusable country-level promotional email for broader campaigns.",
    "category": "promotional",
    "locale": "en",
    "enabled": true,
    "subjectTemplate": "@promo_headline",
    "htmlTemplate": "<html>\n  <body style=\"margin:0;padding:0;background:#f4f7fb;font-family:Arial,sans-serif;color:#16304f;\">\n    <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" style=\"background:#f4f7fb;padding:24px 0;\">\n      <tr>\n        <td align=\"center\">\n          <table role=\"presentation\" width=\"640\" cellspacing=\"0\" cellpadding=\"0\" style=\"max-width:640px;background:#ffffff;border-radius:20px;overflow:hidden;border:1px solid #d9e5f4;\">\n            <tr>\n              <td style=\"background:linear-gradient(135deg,#4458c8,#7a8bf4);padding:28px 32px;color:#ffffff;\">\n                <div style=\"font-size:14px;letter-spacing:0.08em;text-transform:uppercase;opacity:0.88;\">MyScoutee Promotional</div>\n                <h1 style=\"margin:12px 0 0;font-size:30px;line-height:1.2;\">@promo_headline</h1>\n              </td>\n            </tr>\n            <tr>\n              <td style=\"padding:32px;\">\n                <p style=\"margin:0 0 16px;font-size:16px;line-height:1.6;\">Hi @user_first_name,</p>\n                <p style=\"margin:0 0 16px;font-size:16px;line-height:1.6;\">@promo_body</p>\n                <p style=\"margin:0 0 22px;font-size:16px;line-height:1.6;\">This campaign is currently targeted to active members in @user_country_name.</p>\n                <div style=\"margin:24px 0 28px;\">\n                  <a href=\"@cta_url\" style=\"display:inline-block;background:#4458c8;color:#ffffff;text-decoration:none;padding:14px 22px;border-radius:999px;font-weight:700;\">@cta_label</a>\n                </div>\n              </td>\n            </tr>\n          </table>\n        </td>\n      </tr>\n    </table>\n  </body>\n</html>\n",
    "textTemplate": "@promo_headline\n\nHi @user_first_name,\n\n@promo_body\n\nThis campaign is currently targeted to active members in @user_country_name.\n\n@cta_label: @cta_url\n",
    "createdDate": "2026-04-27T00:00:00Z",
    "createdUser": "email-seed",
    "updatedDate": "2026-04-27T00:00:00Z",
    "updatedUser": "email-seed"
  },
  {
    "_id": "email-template-event-stage-reminder-v1",
    "syncKey": "email-template-event-stage-reminder-v1",
    "templateKey": "event-stage-reminder-v1",
    "name": "Event Stage Reminder",
    "description": "Email fallback sent before an accepted member's event stage starts.",
    "category": "event",
    "locale": "en",
    "enabled": true,
    "subjectTemplate": "@stage_name starts soon",
    "htmlTemplate": "<html>\n  <body style=\"margin:0;padding:0;background:#f4f7fb;font-family:Arial,sans-serif;color:#16304f;\">\n    <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" style=\"background:#f4f7fb;padding:24px 0;\">\n      <tr>\n        <td align=\"center\">\n          <table role=\"presentation\" width=\"640\" cellspacing=\"0\" cellpadding=\"0\" style=\"max-width:640px;background:#ffffff;border-radius:20px;overflow:hidden;border:1px solid #d9e5f4;\">\n            <tr>\n              <td style=\"background:#2f6fd6;padding:28px 32px;color:#ffffff;\">\n                <div style=\"font-size:14px;letter-spacing:0.08em;text-transform:uppercase;opacity:0.88;\">MyScoutee Event</div>\n                <h1 style=\"margin:12px 0 0;font-size:30px;line-height:1.2;\">@stage_name starts soon</h1>\n              </td>\n            </tr>\n            <tr>\n              <td style=\"padding:32px;\">\n                <p style=\"margin:0 0 16px;font-size:16px;line-height:1.6;\">Hi @user_first_name,</p>\n                <p style=\"margin:0 0 16px;font-size:16px;line-height:1.6;\">@event_title has an upcoming stage. Open the event before the stage starts so you have the latest details.</p>\n                <p style=\"margin:0 0 22px;color:#5f7694;font-size:14px;line-height:1.6;\">Stage start: @stage_start_at</p>\n                <div style=\"margin:24px 0 28px;\">\n                  <a href=\"@cta_url\" style=\"display:inline-block;background:#2f6fd6;color:#ffffff;text-decoration:none;padding:14px 22px;border-radius:999px;font-weight:700;\">@cta_label</a>\n                </div>\n              </td>\n            </tr>\n          </table>\n        </td>\n      </tr>\n    </table>\n  </body>\n</html>\n",
    "textTemplate": "@stage_name starts soon\n\nHi @user_first_name,\n\n@event_title has an upcoming stage. Open the event before the stage starts so you have the latest details.\n\nStage start: @stage_start_at\n\n@cta_label: @cta_url\n",
    "createdDate": "2026-05-05T00:00:00Z",
    "createdUser": "email-seed",
    "updatedDate": "2026-05-05T00:00:00Z",
