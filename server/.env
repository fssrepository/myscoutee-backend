MYSCOUTEE_VERSION=1.0.0
NGINX_BASE_IMAGE=myscoutee-nginx:${MYSCOUTEE_VERSION}-base
NGINX_IMAGE=myscoutee-nginx:${MYSCOUTEE_VERSION}-dev
NGINX_PRODUCTION_IMAGE=myscoutee-nginx:${MYSCOUTEE_VERSION}-prod
MONGO_IMAGE=mongo:8.0.4
MONGODB_SYNC_IMAGE=myscoutee-mongodb-sync:${MYSCOUTEE_VERSION}-dev
FRONTEND_SYNC_IMAGE=myscoutee-frontend-sync:${MYSCOUTEE_VERSION}-dev
MONGO_DEMO_DATABASE=demo_db
MONGO_REAL_DATABASE=production_db
MONGO_INITDB_DATABASE=demo_db
MONGO_IMPORT_ALLOWED_COLLECTIONS_BY_DB=demo_db:*;myscoutee_db:countryPartitions,i18n_bundles,i18n_messages,ideaPosts,helpCenterRevisions,adminUsers,appSettings,notificationRuleConfigs,affinityConfigs,adminStats,adminMonitoring,accessPolicyDefinitions;production_db:countryPartitions,i18n_bundles,i18n_messages,ideaPosts,helpCenterRevisions,adminUsers,appSettings,notificationRuleConfigs,affinityConfigs,adminStats,adminMonitoring,accessPolicyDefinitions
MONGODB_SEED_SYNC_DEBOUNCE_SECONDS=1
REDIS_IMAGE=redis:8.6.1-alpine
CERT_BOT=certbot/certbot:v5.4.0

MYSCOUTEE_DEV_IMAGE=myscoutee-api:${MYSCOUTEE_VERSION}-dev
MYSCOUTEE_PRODUCTION_IMAGE=myscoutee-api:${MYSCOUTEE_VERSION}-prod
PROFILEMANAGEMENT_HOT_RELOAD=true
OPERATOR_USER=dev@myscoutee.local
CONTAINER_TIMEZONE=Europe/Brussels
MINIO_BASE_IMAGE=minio/minio:RELEASE.2025-09-07T16-13-09Z
MINIO_DEV_IMAGE=myscoutee-minio:${MYSCOUTEE_VERSION}-dev
MINIO_PRODUCTION_IMAGE=myscoutee-minio:${MYSCOUTEE_VERSION}-prod
MEDIA_BUCKET=myscoutee-media
ASSET_SOURCE_REFRESH_ENABLED=true
ASSET_SOURCE_REFRESH_ALLOWED_HOSTS=booking.com,www.booking.com

# Registry integration is opt-in for source production runs. Debian package
# installs enable it with host paths under /etc and /var/lib.
REGISTRY_ENABLED=false
REGISTRY_OUTBOUND_ALLOWED=false
REGISTRY_OPERATOR_REGISTRATION_CONFIRMED=false
REGISTRY_BASE_URL=
REGISTRY_SCOPE=
REGISTRY_PRIVATE_KEY_PATH=/etc/myscoutee/registry/deployment-private-key.pem
REGISTRY_PUBLIC_KEY_PATH=/etc/myscoutee/registry/deployment-public-key.der
REGISTRY_STATE_DIR=/var/lib/myscoutee/registry
REGISTRY_KEY_DIR_HOST=./data/registry-keys
REGISTRY_STATE_DIR_HOST=./data/registry
REGISTRY_CONNECT_TIMEOUT=5s
REGISTRY_REQUEST_TIMEOUT=15s
REGISTRY_RETRY_DELAY=15m
REGISTRY_MAX_RESPONSE_BYTES=1048576
REGISTRY_EXPECTED_KEY_FINGERPRINT=
REGISTRY_TRUST_ON_FIRST_USE=false
REGISTRY_ALLOW_INSECURE_HTTP=false
REGISTRY_INSECURE_HTTP_ALLOWED_HOSTS=

LETSENCRYPT_ENABLED=false
DOMAIN=myscoutee.com
