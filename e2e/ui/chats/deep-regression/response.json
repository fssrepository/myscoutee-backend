{
  "urlPath": "/game",
  "selectors": [
    ".popup-panel-event-chat",
    ".chat-message"
  ],
  "absentSelectors": [
    ".explanation-popup",
    ".confirmation-dialog",
    ".popup-loading-overlay",
    ".chat-message-pending",
    ".chat-message-timed-out"
  ],
  "network": [
