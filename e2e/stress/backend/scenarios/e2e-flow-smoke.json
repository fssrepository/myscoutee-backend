{
  "name": "E2E mutation flow smoke",
  "mode": "e2e",
  "baseUrl": "http://localhost",
  "users": 2,
  "rampUpMs": 1000,
  "iterations": 1,
  "thinkTimeMs": 250,
  "thinkTimeJitterMs": 100,
  "resetE2E": true,
  "thresholds": {
    "errorRate": 0,
    "p95Ms": 20000,
    "maxMs": 45000
  },
  "steps": [
    {
      "name": "event lifecycle",
      "collectionCase": "flows/event-lifecycle/sync-publish-unpublish"
    },
    {
      "name": "asset lifecycle",
      "collectionCase": "flows/assets/upsert-delete-restore"
    },
    {
      "name": "profile state",
      "collectionCase": "flows/profile-state/save-preferences-experiences-rates"
    },
    {
      "name": "share token",
      "collectionCase": "flows/share-token/create-resolve"
    },
    {
      "name": "chat lifecycle",
      "collectionCase": "flows/chat/message-lifecycle"
    },
    {
      "name": "help revision",
      "collectionCase": "flows/help-revision/create-delete"
    },
    {
      "name": "event participation",
      "collectionCase": "flows/event-participation/join-feedback"
    }
  ]
}
