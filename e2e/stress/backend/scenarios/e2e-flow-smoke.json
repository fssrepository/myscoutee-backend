{
  "name": "E2E mutation flow smoke",
  "mode": "e2e",
  "baseUrl": "https://127.0.0.1",
  "qaBranches": {
    "supporting": [
      "ARTICLE-EDITOR-001",
      "ASSET-LIFE-001",
      "ASSET-VIS-001",
      "AUTH-SESSION-001",
      "CHAT-ACTIONS-001",
      "CHAT-CONTENT-001",
      "CHAT-FLOW-001",
      "CHAT-GOVERNANCE-001",
      "CONTENT-ADMIN-LIFECYCLE-001",
      "EVENT-CHAT-LIFECYCLE-001",
      "EVENT-EDITOR-002",
      "EVENT-FEEDBACK-001",
      "EVENT-FEEDBACK-002",
      "EVENT-FEEDBACK-005",
      "EVENT-FEEDBACK-006",
      "EVENT-IMPRESSION-001",
      "EVENT-IMPRESSION-002",
      "EVENT-LIFE-001",
      "EVENT-LIFE-002",
      "EVENT-LIFE-003",
      "EVENT-LIFE-004",
      "EVENT-LIFE-005",
      "EVENT-NOTIFICATION-001",
      "EVENT-PUBLISH-CHAT-001"
    ]
  },
  "users": 2,
  "rampUpMs": 1000,
  "iterations": 1,
  "thinkTimeMs": 250,
  "thinkTimeJitterMs": 100,
  "resetE2E": true,
  "thresholds": {
    "errorRate": 0,
    "p95Ms": 20000,
    "maxMs": 45000
  },
  "steps": [
    {
      "name": "event lifecycle",
      "collectionCase": "flows/event-lifecycle/sync-publish-unpublish"
    },
    {
      "name": "asset lifecycle",
      "collectionCase": "flows/assets/upsert-delete-restore"
    },
    {
      "name": "profile state",
      "collectionCase": "flows/profile-state/save-preferences-experiences-rates"
    },
    {
      "name": "share token",
      "collectionCase": "flows/share-token/create-resolve"
    },
    {
      "name": "chat lifecycle",
      "collectionCase": "flows/chat/message-lifecycle"
    },
    {
      "name": "help revision",
      "collectionCase": "flows/help-revision/create-delete"
    },
    {
      "name": "event participation",
      "collectionCase": "flows/event-participation/join-feedback"
    },
    {
      "name": "two-session authentication limit",
      "collectionCase": "flows/auth-session/two-session-limit"
    }
  ]
}
