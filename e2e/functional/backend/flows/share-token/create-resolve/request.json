        "languages": ["en"],
        "initials": "SO",
        "gender": "man",
        "statusText": "E2E share token owner",
        "profileStatus": "public",
        "images": []
      }
    },
    {
      "name": "seed share token asset",
      "method": "POST",
      "path": "/api/assets/upsert",
      "headers": {
        "X-App-Session-Kind": "demo"
      },
      "expectedStatus": 200,
      "body": {
        "userId": "{{e2eUserId}}",
        "asset": {
          "id": "e2e-share-asset-{{runId}}",
