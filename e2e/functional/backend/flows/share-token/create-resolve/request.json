{
  "name": "e2e share token: create and resolve asset token",
  "group": "flows",
  "order": 9030,
  "method": "POST",
  "path": "/api/share-tokens",
  "script": "share-token.mjs",
  "mutation": true,
  "e2eOnly": true,
  "headers": {
    "X-App-Session-Kind": "demo"
  },
  "setup": [
    {
      "name": "seed share token owner profile",
      "method": "POST",
      "path": "/api/auth/me/profile",
      "headers": {
        "X-App-Session-Kind": "demo"
      },
      "expectedStatus": 200,
      "body": {
        "id": "{{e2eUserId}}",
        "name": "E2E Share Owner",
        "age": 31,
        "birthday": "1995-01-12",
        "city": "Bratislava",
        "height": "180 cm",
