          "imageUrl": "",
          "sourceLink": "",
          "routes": [],
          "policies": [],
          "visibility": "Public",
          "status": "active",
          "ownerUserId": "{{e2eUserId}}",
          "ownerName": "E2E Share Owner",
          "requests": [],
          "menuActions": []
        }
      }
    }
  ],
  "body": {
    "kind": "asset",
    "entityId": "e2e-share-asset-{{runId}}",
    "assetType": "Accommodation",
    "ownerUserId": "{{e2eUserId}}"
  },
  "expectedStatus": 200,
  "maxMs": 5000
}
