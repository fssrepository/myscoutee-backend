{
  "project": "myscoutee-backend",
  "type": "application",
  "depends_on": [
    "myscoutee-frontend",
    "myscoutee-base",
    "myscoutee-packaging",
    "myscoutee-nginx",
    "myscoutee-mcp",
    "myscoutee-registry",
    "myscoutee-payment-simulator",
    "myscoutee-microservices",
    "myscoutee-e2e",
    "myscoutee-qa"
  ],
  "frontend": "myscoutee-frontend",
  "deploy": [
    "kvm",
    "vmware",
    "monolith",
    "netcup"
  ],
  "variables": {
    "LAB_GITHUB_REPOSITORY": "fssrepository/myscoutee-backend",
    "LAB_KUBE_CONTEXT": "myscoutee/ci:backend-kvm",
    "LAB_KUBE_NAMESPACE": "myscoutee-msc121",
    "MYSCOUTEE_COMPATIBLE_PACKAGE_VERSIONS": "1.5.0"
