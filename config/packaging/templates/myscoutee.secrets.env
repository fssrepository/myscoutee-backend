# MyScoutee production secrets.
# Installed as /etc/myscoutee/myscoutee.secrets.env and linked to /opt/myscoutee/server/.env.secrets.
# The Debian installer replaces the Mongo, MinIO, and internal payment
# simulator secret placeholders on first install. If no Operator identity was
# supplied, it also stores the
# generated bootstrap subject and only the SHA-256 hash of its cryptographically
# random password here. The helper prints the plaintext once but never writes it
# to MyScoutee configuration; package-manager or terminal logs may capture it.

MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=replace-with-strong-root-password
MONGO_APP_USERNAME=myscoutee_app
MONGO_APP_PASSWORD=replace-with-strong-app-password

MINIO_ROOT_USER=myscoutee-minio
MINIO_ROOT_PASSWORD=replace-with-strong-minio-password

OPERATOR_BOOTSTRAP_EMAIL=
OPERATOR_BOOTSTRAP_PASSWORD_SHA256=

FIREBASE_SERVICE_ACCOUNT_PATH=/run/secrets/firebase-service-account.json
FACEBOOK_APP_SECRET=
FCM_API_KEY=

PAYMENT_STRIPE_API_KEY=
PAYMENT_BARION_API_KEY=
PAYMENT_SIMULATOR_API_KEY=
PAYMENT_SIMULATOR_WEBHOOK_SECRET=
PAYMENT_SIMULATOR_BARION_POS_KEY=

EMAIL_SENDGRID_API_KEY=
