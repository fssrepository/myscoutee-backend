      },
      {
        "name": "demo_db",
        "source": "demo_db"
      }
    ],
    "scripts": [
      "migrate-production-data.sh",
      "migrate-seeded-media.py",
      "run-data-migrations.js",
      "sync-release-system-seeds.js",
      "sync-i18n-seeds.sh",
      "release-project.sh",
      "release-system-seeds.json",
      "migration-settings.json"
    ],
    "installedScripts": [
      "migrate-production-data.sh",
      "run-data-migrations.js",
      "sync-release-system-seeds.js",
      "sync-i18n-seeds.sh",
      "migration-settings.json"
    ],
    "apiService": "profilemanagement",
    "startupScript": "sync-i18n-seeds.sh",
