{
  "schemaVersion": 1,
  "build": {
    "privateBuildServices": [
      "profilemanagement",
      "nginx",
      "minio",
      "payment-simulator",
      "mcp"
    ],
    "privateReloadServices": [
      "profilemanagement",
      "nginx",
      "minio",
      "payment-simulator",
      "mcp"
    ],
    "rebuildImageEnvironments": [
      "NGINX_BASE_IMAGE",
      "NGINX_PRODUCTION_IMAGE",
      "MYSCOUTEE_PRODUCTION_IMAGE",
      "MINIO_PRODUCTION_IMAGE",
      "PAYMENT_SIMULATOR_IMAGE",
      "MCP_IMAGE"
    ],
    "nginxNativeImage": "ghcr.io/fssrepository/myscoutee-nginx:1.5.0@sha256:7ec3ba085e30314d5536401ac22e14064d30a5461bfc1a9ccbe0e6340b6c6c24"
  },
  "partialData": {
