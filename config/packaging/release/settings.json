        "user": "65532:65532",
        "entrypoint": [
          "/registry"
        ],
        "ports": [
          "8080/tcp"
        ]
      },
      "payment-simulator": {
        "user": "65532:65532",
        "entrypoint": [
          "/payment-simulator"
        ],
        "ports": [
          "18082/tcp"
        ],
        "workingDirectory": "/data"
      }
    },
    "internalComposeServices": [
      {
        "service": "registry",
        "label": "Explore registry"
      },
      {
        "service": "payment-simulator",
        "label": "payment simulator"
      }
    ],
    "archiveContractServices": [
      "payment-simulator"
    ]
