{
  "openapi": "3.1.0",
  "info": {
    "title": "MyScoutee internal event-membership-facts reads",
    "version": "1.0.0",
    "description": "Focused facts for the existing membership policy; canonical owner queries and caller-side workspace filtering remain unchanged. Dedicated service credential and REAL/DEMO mode. No mutation or delegated user authority. Maximum response 2 MiB."
  },
  "paths": {
    "/_internal/v1/events/membership-facts": {
      "get": {
        "operationId": "readEventMembershipFacts",
        "security": [
          {
            "event-membership-facts": []
          }
        ],
        "parameters": [
          {
            "name": "X-MyScoutee-Session-Mode",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "REAL",
                "DEMO"
              ]
            }
          },
          {
            "name": "id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Existing membership-policy facts; bounded to 2 MiB.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventMembershipFactsResponse"
                }
              }
            }
          },
          "400": {
            "description": "INVALID_SESSION_MODE or INVALID_REQUEST",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "UNAUTHORIZED: absent, duplicate or wrong read credential",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "FORBIDDEN: credential does not authorize another path or method",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "EVENT_MEMBERSHIP_FACTS_UNAVAILABLE: owner failed; persistence details are not exposed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "event-membership-facts": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "code"
        ],
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "INVALID_SESSION_MODE",
              "INVALID_REQUEST",
              "UNAUTHORIZED",
              "FORBIDDEN",
              "NOT_FOUND",
              "EVENT_MEMBERSHIP_FACTS_UNAVAILABLE"
            ]
          }
        }
      },
      "EventMembershipFactsResponse": {
        "type": "array",
        "items": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "workspaceGroupId",
            "updatedDate",
            "creatorUserId",
            "status",
            "admins"
          ],
          "properties": {
            "workspaceGroupId": {
              "type": [
                "string",
                "null"
              ]
            },
            "updatedDate": {
              "type": [
                "string",
                "null"
              ]
            },
            "creatorUserId": {
              "type": [
                "string",
                "null"
              ]
            },
            "status": {
              "type": [
                "string",
                "null"
              ]
            },
            "admins": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    }
  }
}
