{
  "openapi": "3.1.0",
  "info": {
    "title": "MyScoutee organizer-event-reads",
    "version": "1.0.0",
    "description": "Event-owner facts for following counters and expiry. The existing owner queries, ordering and duplicates are preserved. Following eligibility remains in its existing account service. Only the 11 consumed event fields cross the boundary. Service-scoped capability is issued only to accounts and the owner, with mandatory REAL/DEMO context. Requests are bounded to 4096 identifiers / 2 MiB; replies are capped at 8 MiB and never silently truncated. No retries."
  },
  "paths": {
    "/_internal/v1/events/organizer-events/creators": {
      "post": {
        "operationId": "activeOriginalEventsByCreators",
        "security": [
          {
            "serviceCapability": []
          }
        ],
        "parameters": [
          {
            "name": "X-MyScoutee-Session-Mode",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "REAL",
                "DEMO"
              ]
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Query"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Canonical owner result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Result"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or session mode",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong service capability",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Request exceeds byte limit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "JSON content type required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Owner unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/_internal/v1/events/organizer-events/sources": {
      "post": {
        "operationId": "storedEventsBySources",
        "security": [
          {
            "serviceCapability": []
          }
        ],
        "parameters": [
          {
            "name": "X-MyScoutee-Session-Mode",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "REAL",
                "DEMO"
              ]
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Query"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Canonical owner result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Result"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or session mode",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong service capability",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Request exceeds byte limit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "JSON content type required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Owner unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "serviceCapability": {
        "type": "http",
        "scheme": "bearer",
        "description": "Dedicated organizer-event read credential; server-only, at least 256 random bits."
      }
    },
    "schemas": {
      "Query": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ids"
        ],
        "properties": {
          "ids": {
            "type": "array",
            "maxItems": 4096,
            "items": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 512
            }
          }
        }
      },
      "Result": {
        "type": "array",
        "items": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "sourceId": {
              "type": [
                "string",
                "null"
              ]
            },
            "creatorUserId": {
              "type": [
                "string",
                "null"
              ]
            },
            "status": {
              "type": [
                "string",
                "null"
              ]
            },
            "eventType": {
              "type": [
                "string",
                "null"
              ]
            },
            "parentEventId": {
              "type": [
                "string",
                "null"
              ]
            },
            "visibility": {
              "type": [
                "string",
                "null"
              ]
            },
            "startAtIso": {
              "type": [
                "string",
                "null"
              ]
            },
            "endAtIso": {
              "type": [
                "string",
                "null"
              ]
            },
            "published": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "generated": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "isTrashed": {
              "type": [
                "boolean",
                "null"
              ]
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "INVALID_REQUEST",
              "INVALID_SESSION_MODE",
              "UNAUTHORIZED",
              "FORBIDDEN",
              "QUERY_TOO_LARGE",
              "INVALID_CONTENT_TYPE",
              "ORGANIZER_EVENTS_UNAVAILABLE"
            ]
          }
        }
      }
    }
  }
}
