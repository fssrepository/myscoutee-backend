{
  "openapi": "3.1.0",
  "info": {
    "title": "EventPrivacy account-purge boundary",
    "version": "1.0.0",
    "description": "Accounts-only worker capability for the existing durable account-purge stages. Native owner performs deletion/redaction; REAL/DEMO and active/inactive/null workspace job scope are preserved. No transport retries. Media cleanup precedes record removal. 2 MiB requests, 8 MiB responses, at most 4096 IDs. Runtime and lost-response/restart verification pending."
  },
