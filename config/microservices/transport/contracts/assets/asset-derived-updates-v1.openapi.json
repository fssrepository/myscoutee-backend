        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "updatedDate"
        ],
        "properties": {
          "id": {
            "type": [
              "string",
              "null"
            ]
          },
          "updatedDate": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "AffinityCommand": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version",
          "affinity",
          "boost"
        ],
        "properties": {
          "version": {
            "anyOf": [
