                "$ref": "#/components/schemas/AssetVersionDto"
              },
              {
                "type": "null"
              }
            ]
          },
          "affinity": {
            "type": "number"
          },
          "boost": {
            "type": "number"
          }
        }
      },
      "StatusCommand": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version",
