              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 512
          },
          "previousStatus": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 512
          }
        }
      },
      "Result": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "matched"
        ],
        "properties": {
          "matched": {
            "type": "boolean"
          }
        }
      },
      "Error": {
        "type": "object",
