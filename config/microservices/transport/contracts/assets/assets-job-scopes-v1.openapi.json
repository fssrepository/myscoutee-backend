{
  "openapi": "3.1.0",
  "info": {
    "title": "MyScoutee internal assets job ownership",
    "version": "1.0.0",
    "description": "Reads the existing assets owner job-scope lookup by public resource ID. Carries only stored workspace, owner and creator IDs. Platform JobAudience remains responsible for base-group selection and fallback. REAL/DEMO mode and service capability are required. Missing record is 404 NOT_FOUND; lookup failure remains 503, never missing. Maximum response 8 KiB."
  },
  "paths": {
    "/_internal/v1/assets/job-scope": {
      "get": {
        "operationId": "findAssetJobScope",
        "security": [
          {
            "chatDirectoryRead": []
          }
        ],
        "parameters": [
          {
            "name": "X-MyScoutee-Session-Mode",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "REAL",
                "DEMO"
              ]
            }
          },
          {
            "name": "id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 512
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Stored resource job scope",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Scope"
                }
              }
            }
          },
          "400": {
            "description": "INVALID_SESSION_MODE or INVALID_REQUEST",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "UNAUTHORIZED: absent, duplicate or wrong read credential",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "FORBIDDEN: credential does not authorize another path or method",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Owner unavailable; not interpreted as absence",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "NOT_FOUND: the canonical directory has no group for this ID in the selected session mode.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "chatDirectoryRead": {
        "type": "http",
        "scheme": "bearer",
        "description": "Dedicated internal group-media read credential of at least 256 random bits. Never distribute to browsers or put in URLs."
      }
    },
    "schemas": {
      "Scope": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "workspaceGroupId": {
            "type": [
              "string",
              "null"
            ]
          },
          "ownerUserId": {
            "type": [
              "string",
              "null"
            ]
          },
          "creatorUserId": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "INVALID_SESSION_MODE",
              "INVALID_REQUEST",
              "UNAUTHORIZED",
              "FORBIDDEN",
              "NOT_FOUND",
              "SCOPE_UNAVAILABLE"
            ]
          }
        }
      }
    }
  }
}
