{
  "openapi": "3.1.0",
  "info": {
    "title": "MyScoutee internal managed community groups",
    "version": "1.0.0",
    "description": "Read-only group IDs from canonical GroupAdministrationService and CommunityAccessService policy. Accepted Admin membership, community type, base-group exclusion, deletion and awaiting-owner exclusions remain in the existing owner. This endpoint never grants an admin role. Service capability and REAL/DEMO mode required. 512-character account ID, 1 MiB response; owner failure never becomes an empty set."
  },
  "paths": {
    "/_internal/v1/groups/administration/managed": {
      "get": {
        "operationId": "managedGroups",
        "security": [
          {
            "chatDirectoryRead": []
          }
        ],
        "parameters": [
          {
            "name": "X-MyScoutee-Session-Mode",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "REAL",
                "DEMO"
              ]
            }
          },
          {
            "name": "accountId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 512
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Canonical set of managed group IDs",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Groups"
                }
              }
            }
          },
          "400": {
            "description": "INVALID_SESSION_MODE or INVALID_REQUEST",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "UNAUTHORIZED: absent, duplicate or wrong read credential",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "FORBIDDEN: credential does not authorize another path or method",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Group owner unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "chatDirectoryRead": {
        "type": "http",
        "scheme": "bearer",
        "description": "Dedicated internal group-media read credential of at least 256 random bits. Never distribute to browsers or put in URLs."
      }
    },
    "schemas": {
      "Groups": {
        "type": "array",
        "uniqueItems": true,
        "items": {
          "type": "string"
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "INVALID_SESSION_MODE",
              "INVALID_REQUEST",
              "UNAUTHORIZED",
              "FORBIDDEN",
              "GROUP_ADMINISTRATION_UNAVAILABLE"
            ]
          }
        }
      }
    }
  }
}
