{
  "openapi": "3.1.0",
  "info": {
    "title": "MyScoutee internal community media visibility reads",
    "version": "1.0.0",
    "description": "Typed CommunityMediaVisibility read contract. Dedicated service credential permits metadata reads for media policy evaluation, never establishes user authority. REAL/DEMO is mandatory. HTTPS except isolated-lab opt-in. POST carries URL variants as a bounded JSON query instead of an oversized request line. No mutation, retries or redirects."
  },
  "paths": {
    "/_internal/v1/community/media/announcement": {
      "post": {
        "operationId": "getAnnouncementMediaVisibility",
        "security": [
          {
            "communityMediaRead": []
          }
        ],
        "parameters": [
          {
            "name": "X-MyScoutee-Session-Mode",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "REAL",
                "DEMO"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Minimal community media metadata; maximum response 4 KiB.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnnouncementMediaVisibilityDto"
                }
              }
            }
          },
          "400": {
            "description": "INVALID_SESSION_MODE or INVALID_REQUEST",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "UNAUTHORIZED: absent, duplicate or wrong read credential",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "FORBIDDEN: credential does not authorize another path or method",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "COMMUNITY_VISIBILITY_UNAVAILABLE: canonical owner failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "NOT_FOUND: no matching reference in the selected mode.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "QUERY_TOO_LARGE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "INVALID_CONTENT_TYPE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "description": "Maximum 1 MiB of JSON, including chunked requests.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MediaUrlsQueryDto"
              }
            }
          }
        }
      }
    },
    "/_internal/v1/community/media/offering": {
      "post": {
        "operationId": "getOfferingMediaVisibility",
        "security": [
          {
            "communityMediaRead": []
          }
