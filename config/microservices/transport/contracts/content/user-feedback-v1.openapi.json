{
  "openapi": "3.1.0",
  "info": {
    "title": "MyScoutee internal feedback submission",
    "version": "1.0.0",
    "description": "Canonical feedback storage with a stable request ID. Both service capability and identity-signed RS256 actor delegation are required. Delegation binds exact body, path, POST, audience, REAL/DEMO mode and the authenticated selected profile/account/workspace; maximum lifetime 30 seconds. Only the accounts owner has the signing key. The receiver checks the signed actor against the submitted user. No automatic retry; a lost reply is an unknown outcome."
  },
  "paths": {
    "/_internal/v1/content/user-feedback": {
      "post": {
        "operationId": "submitUserFeedbackOnce",
        "security": [
          {
            "serviceCapability": []
          }
        ],
        "parameters": [
          {
            "name": "X-MyScoutee-Session-Mode",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "REAL",
                "DEMO"
              ]
            }
          },
          {
            "name": "X-MyScoutee-Actor-Delegation",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 8192
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Command"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Stored feedback ID. Exact replay preserves the original record.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Receipt"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request or session mode",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing/wrong service capability",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Invalid actor delegation or actor mismatch",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Request ID already belongs to different data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Body exceeds 64 KiB",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "JSON content type required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Outcome unknown; do not create a new retry ID",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "serviceCapability": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Command": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requestId",
          "userId",
          "category",
          "subject",
          "details"
        ],
        "properties": {
          "requestId": {
            "type": "string",
            "pattern": "^[a-f0-9]{24}$"
          },
          "userId": {
            "type": "string",
            "maxLength": 512
          },
          "category": {
            "type": "string"
          },
          "subject": {
            "type": "string"
          },
          "details": {
            "type": "string"
          }
        }
      },
      "Receipt": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-f0-9]{24}$"
          }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "INVALID_SESSION_MODE",
              "INVALID_REQUEST",
              "UNAUTHORIZED",
              "FORBIDDEN",
              "INVALID_DELEGATION",
              "ACTOR_MISMATCH",
              "QUERY_TOO_LARGE",
              "INVALID_CONTENT_TYPE",
              "REQUEST_CONFLICT",
              "SUBMISSION_OUTCOME_UNKNOWN"
            ]
          }
        }
      }
    }
  }
}
