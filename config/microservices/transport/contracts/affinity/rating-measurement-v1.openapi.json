{
  "openapi": "3.1.0",
  "info": {
    "title": "MyScoutee rating-measurement",
    "version": "1.0.0",
    "description": "Operator-only sorted measurement evidence from the existing owner cursor. Each row contains four persisted evidence fields. Consumer retains existing qualification and accounting validation. Terminal exact count and clean EOF required; interrupted streams fail the measurement. 4 KiB request, 16 KiB frame, 256 MiB total response; bounded HTTP backpressure and closeable cursors, no full-list buffering, retries or cursor tokens. REAL/DEMO and explicit job scope preserved. Configured ten-minute deadline including body consumption, hard maximum fifteen minutes."
  },
  "paths": {
    "/_internal/v1/affinity/rating-measurement/rates": {
      "post": {
        "operationId": "rating_measurement_rates",
        "security": [
          {
            "serviceCapability": []
          }
        ],
        "parameters": [
          {
            "name": "X-MyScoutee-Session-Mode",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "REAL",
                "DEMO"
              ]
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Query"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Ordered evidence frames followed by the exact terminal count",
            "content": {
              "application/x-ndjson": {
                "schema": {
                  "$ref": "#/components/schemas/Frame"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or session mode",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong service capability",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Request exceeds byte limit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "JSON content type required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Canonical owner unavailable; operation outcome is not assumed successful",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "serviceCapability": {
        "type": "http",
        "scheme": "bearer",
        "description": "Dedicated rating-measurement read capability for the operator domain."
      }
    },
    "schemas": {
      "Query": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "active": {
            "type": "boolean"
          },
          "groupId": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 512
          },
          "startInclusive": {
            "type": "string",
            "format": "date-time"
          },
          "endExclusive": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "active",
          "startInclusive",
          "endExclusive"
        ]
      },
      "Evidence": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "userId": {
            "type": [
              "string",
              "null"
            ]
          },
          "actionType": {
            "type": [
              "string",
              "null"
            ]
          },
          "occurredAt": {
            "type": [
              "string",
              "null"
            ]
          },
          "sourceId": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": []
      },
      "Row": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "const": "evidence"
          },
          "evidence": {
            "$ref": "#/components/schemas/Evidence"
          },
          "count": {
            "type": "null"
          }
        },
        "required": [
          "kind",
          "evidence"
        ]
      },
      "Complete": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "const": "complete"
          },
          "evidence": {
            "type": "null"
          },
          "count": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "kind",
          "count"
        ]
      },
      "Frame": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/Row"
          },
          {
            "$ref": "#/components/schemas/Complete"
          }
        ]
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          }
        },
        "required": [
          "code"
        ]
      }
    }
  },
  "x-stream-protocol": "measurement-evidence-v1"
}
