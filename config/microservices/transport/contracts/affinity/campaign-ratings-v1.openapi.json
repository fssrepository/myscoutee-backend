  "components": {
    "securitySchemes": {
      "serviceCapability": {
        "type": "http",
        "scheme": "bearer",
        "description": "Dedicated campaign-ratings capability for campaigns."
      }
    },
    "schemas": {
      "Query": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "scope": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Scope"
              },
              {
                "type": "null"
              }
            ]
          },
          "viewer": {
            "type": [
              "string",
              "null"
            ]
          },
          "target": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "scope"
        ]
      },
      "Scope": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "active": {
            "type": "boolean"
          },
          "groupId": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "active"
        ]
      },
      "Evidence": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "mode": {
            "type": [
              "string",
              "null"
            ]
          },
          "ownerUserId": {
            "type": [
              "string",
              "null"
            ]
          },
          "campaignId": {
            "type": [
              "string",
              "null"
            ]
          },
          "scoreGiven": {
            "type": [
              "number",
              "null"
            ]
          },
          "createdDate": {
            "type": [
              "string",
              "null"
            ]
          },
          "updatedDate": {
            "type": [
              "string",
              "null"
            ]
          },
          "ratingSnapshots": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/RatingSnapshot"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "required": []
      },
      "RatingSnapshot": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "version": {
            "type": [
              "integer",
              "null"
            ]
          },
          "profileType": {
            "type": [
              "string",
              "null"
            ]
          },
          "criteria": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": {
              "type": [
                "number",
                "null"
              ]
            }
          },
          "average": {
            "type": [
              "number",
              "null"
            ]
          }
        },
        "required": []
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "enum": [
              "INVALID_REQUEST",
              "INVALID_SESSION_MODE",
              "UNAUTHORIZED",
              "FORBIDDEN",
              "QUERY_TOO_LARGE",
              "INVALID_CONTENT_TYPE",
              "OWNER_REJECTED",
              "CAMPAIGN_RATINGS_UNAVAILABLE"
            ]
          }
        },
        "required": [
          "code"
        ]
      }
