  "components": {
    "securitySchemes": {
      "serviceCapability": {
        "type": "http",
        "scheme": "bearer",
        "description": "Payments-only payment-totals capability."
      }
    },
    "schemas": {
      "Scope": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "active": {
            "type": "boolean"
          },
          "groupId": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 512
          }
        },
        "required": [
          "active"
        ]
      },
      "Delta": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "scope": {
            "$ref": "#/components/schemas/Scope"
          },
          "userId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "direction": {
            "enum": [
              "SPENT",
              "INCOME",
              "ALL"
            ]
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "amount": {
            "type": "number"
          }
        },
        "required": [
          "scope",
          "userId",
          "direction",
          "currency",
          "amount"
        ]
      },
      "Reversal": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "scope": {
            "$ref": "#/components/schemas/Scope"
          },
          "userId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "receiptId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "direction": {
            "enum": [
              "SPENT",
              "INCOME",
              "ALL"
            ]
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "amount": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "scope",
          "userId",
          "receiptId",
          "direction",
          "currency",
          "amount"
        ]
      },
      "User": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "scope": {
            "$ref": "#/components/schemas/Scope"
          },
          "userId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "required": [
          "scope",
          "userId"
        ]
      },
      "Currency": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "scope": {
            "$ref": "#/components/schemas/Scope"
          },
          "userId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          }
        },
        "required": [
          "scope",
          "userId",
          "currency"
        ]
      },
      "CurrencyResult": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "resolved": {
            "const": true
          },
          "value": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "resolved"
        ]
      },
      "Receipt": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "completed": {
            "const": true
          }
        },
        "required": [
          "completed"
        ]
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "INVALID_REQUEST",
              "INVALID_SESSION_MODE",
              "UNAUTHORIZED",
              "FORBIDDEN",
              "QUERY_TOO_LARGE",
              "INVALID_CONTENT_TYPE",
              "PAYMENT_TOTALS_UNAVAILABLE"
            ]
          }
        },
        "required": [
          "code"
        ]
      }
    }
  }
