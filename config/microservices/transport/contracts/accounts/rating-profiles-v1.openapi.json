{
  "openapi": "3.1.0",
  "info": {
    "title": "MyScoutee internal rating profile facts",
    "version": "1.0.0",
    "description": "Read-only batch of account-owned facts for rating ingestion and activity lists. The existing account visibility policy decides activityRateVisible; the caller receives no persistence document, token, device, integration, or payment data. The caller retains workspace admission checks. Service capability and explicit REAL/DEMO mode are required. Order, duplicates, nulls and canonical absence are preserved."
  },
  "paths": {
    "/_internal/v1/accounts/rating-profiles": {
      "post": {
        "operationId": "queryRatingProfiles",
        "security": [
          {
            "serviceCapability": []
          }
        ],
        "parameters": [
          {
            "name": "X-MyScoutee-Session-Mode",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "REAL",
                "DEMO"
              ]
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IdsQuery"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Account-owned rating facts with canonical activity visibility",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Profiles"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request or session mode",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing/wrong service capability",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Unsupported method",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Body exceeds 1 MiB",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "JSON content type required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Account owner unavailable; not an empty profile list",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "serviceCapability": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "IdsQuery": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ids"
        ],
        "properties": {
          "ids": {
            "type": [
              "array",
              "null"
            ],
            "maxItems": 4096,
            "items": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 512
            }
          }
        }
      },
      "Profiles": {
        "type": "array",
        "items": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "id",
            "userId",
            "workspaceGroupId",
            "locationCoordinates",
            "activityRateVisible"
          ],
          "properties": {
            "id": {
              "type": [
                "string",
                "null"
              ]
            },
            "userId": {
              "type": [
                "string",
                "null"
              ]
            },
            "workspaceGroupId": {
              "type": [
                "string",
                "null"
              ]
            },
            "activityRateVisible": {
              "type": "boolean"
            },
            "locationCoordinates": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": false,
              "required": [
                "latitude",
                "longitude"
              ],
              "properties": {
                "latitude": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "longitude": {
                  "type": [
                    "number",
                    "null"
                  ]
                }
              }
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "INVALID_SESSION_MODE",
              "INVALID_REQUEST",
              "UNAUTHORIZED",
              "FORBIDDEN",
              "QUERY_TOO_LARGE",
              "INVALID_CONTENT_TYPE",
              "RATING_PROFILES_UNAVAILABLE"
            ]
          }
        }
      }
    }
  }
}
