{
  "openapi": "3.1.0",
  "info": {
    "title": "friendship-projections",
    "version": "1.0.0",
    "description": "Affinity-only capability. Existing account pair projection preserves earliest friendsSince and latest lastMetAt using native Mongo update pipelines. Canonical sorted pair input; 512 entries / 2 MiB per batch, 16 KiB receipt. Full client input validated before first batch. No automatic retries; partial earlier batches may have completed. End-to-end meeting/rating/following coordination still requires workflow verification."
  },
  "paths": {
    "/_internal/v1/accounts/friendships/meetings": {
      "post": {
        "operationId": "meetings",
        "security": [
          {
            "serviceCapability": []
          }
        ],
        "parameters": [
          {
            "name": "X-MyScoutee-Session-Mode",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "REAL",
                "DEMO"
              ]
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Command"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Canonical owner result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Receipt"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or session mode",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong service capability",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Request exceeds byte limit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "JSON content type required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Owner unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "serviceCapability": {
        "type": "http",
        "scheme": "bearer",
        "description": "Dedicated profile-summary read credential; server-only, at least 256 random bits."
      }
    },
    "schemas": {
      "Meeting": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "left",
          "right",
          "projectedAtMs"
        ],
        "properties": {
          "left": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "right": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "projectedAtMs": {
            "type": "integer",
            "format": "int64"
          },
          "eventId": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 512
          },
          "eventName": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 4096
          }
        }
      },
      "Command": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "meetings"
        ],
        "properties": {
          "meetings": {
            "type": "array",
            "maxItems": 512,
            "items": {
              "$ref": "#/components/schemas/Meeting"
            }
          }
        }
      },
      "Receipt": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "completed"
        ],
        "properties": {
          "completed": {
            "const": true
          }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "type": "string"
          }
        }
      }
    }
  }
}
