{
  "openapi": "3.1.0",
  "info": {
    "title": "MyScoutee account-job-scopes",
    "version": "1.0.0",
    "description": "One native matchingOwners query for an explicit workspace scope. Included/excluded semantics and duplicate owner handling remain in AccountJobScopeService. No account document is serialized. REAL/DEMO is preserved; 2 MiB request/response. Uses a service-scoped read capability and the existing bounded no-retry transport. Results are not authorization to perform unrelated user/admin actions."
  },
  "paths": {
    "/_internal/v1/accounts/job-scopes/matching-owners": {
      "post": {
        "operationId": "account_job_scopes",
        "security": [
          {
            "serviceCapability": []
          }
        ],
        "parameters": [
          {
            "name": "X-MyScoutee-Session-Mode",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "REAL",
                "DEMO"
              ]
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Query"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Canonical owner result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Result"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or session mode",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong service capability",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Request exceeds byte limit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "JSON content type required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Owner unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "serviceCapability": {
        "type": "http",
        "scheme": "bearer",
        "description": "Dedicated service capability for this contract; never expose to browsers."
      }
    },
    "schemas": {
      "Query": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ids",
          "scope"
        ],
        "properties": {
          "ids": {
            "type": "array",
            "maxItems": 4096,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          },
          "scope": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ids",
              "included"
            ],
            "properties": {
              "ids": {
                "type": "array",
                "uniqueItems": true,
                "maxItems": 1024,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                }
              },
              "included": {
                "type": "boolean"
              }
            }
          }
        }
      },
      "Result": {
        "type": "array",
        "items": {
          "type": "string",
          "maxLength": 512
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "INVALID_REQUEST",
              "INVALID_SESSION_MODE",
              "UNAUTHORIZED",
              "FORBIDDEN",
              "QUERY_TOO_LARGE",
              "INVALID_CONTENT_TYPE",
              "ACCOUNT_JOB_SCOPES_UNAVAILABLE"
            ]
          }
        }
      }
    }
  }
}
