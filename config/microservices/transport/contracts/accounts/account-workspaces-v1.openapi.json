{
  "openapi": "3.1.0",
  "info": {
    "title": "MyScoutee account-workspaces",
    "version": "1.0.0",
    "description": "Native workspace selection, membership checks, admission and activation remain at the account owner. Activation reloads the account locally. Group roster returns only profileId and owner-computed attention, in one batch; no per-row remote counter calls. Group policy input reuses the native group DTO. Unknown reply/restart recovery remains milestone 16. Mandatory REAL/DEMO and explicit job scope; no-store, 2 MiB request and 8 MiB response bounds, no retries."
  },
