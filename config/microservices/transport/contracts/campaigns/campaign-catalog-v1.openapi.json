    "/_internal/v1/campaigns/catalog/organizer-contact": {
      "post": {
        "operationId": "organizerContact",
        "security": [
          {
            "serviceCapability": []
          }
        ],
        "parameters": [
          {
            "name": "X-MyScoutee-Session-Mode",
            "in": "header",
