        "description": "Read campaign availability and positive-rating facts for an organizer conversation. The chat caller supplies its already-authenticated profile and retains public authorization and chat writes."
      },
      "delete": {
        "operationId": "rejectOrganizerContactMutation",
        "description": "This read capability forbids mutation methods.",
        "responses": {
