  "components": {
    "securitySchemes": {
      "serviceCapability": {
        "type": "http",
        "scheme": "bearer",
        "description": "Dedicated profile-summary read credential; server-only, at least 256 random bits."
      }
    },
    "schemas": {
      "Campaign": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "workspaceGroupId",
          "ownerUserId",
          "title",
          "status"
        ],
        "properties": {
          "id": {
            "type": [
              "string",
              "null"
            ]
          },
          "workspaceGroupId": {
            "type": [
              "string",
              "null"
            ]
          },
          "ownerUserId": {
            "type": [
              "string",
              "null"
            ]
          },
          "title": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "SingleQuery": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 512
          }
        }
      },
      "BatchQuery": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ids"
        ],
        "properties": {
          "ids": {
            "type": "array",
            "maxItems": 4096,
            "items": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 512
            }
          }
        }
      },
      "OwnedQuery": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ownerUserId",
          "id"
        ],
        "properties": {
          "ownerUserId": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 512
          },
          "id": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 512
          }
        }
      },
      "SingleResult": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "resolved",
          "value"
        ],
        "properties": {
          "resolved": {
            "const": true
          },
          "value": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Campaign"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "Campaigns": {
        "type": "object",
        "additionalProperties": {
          "$ref": "#/components/schemas/Campaign"
        }
      },
      "Decision": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "value"
        ],
        "properties": {
          "value": {
            "type": "boolean"
          }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "type": "string"
          }
        }
      },
      "OrganizerContactQuery": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "viewerId",
          "workspaceGroupId"
        ],
        "properties": {
          "id": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 512
          },
          "viewerId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "workspaceGroupId": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 512
          }
        }
      },
      "OrganizerContactResult": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "resolved",
          "value"
        ],
        "properties": {
          "resolved": {
            "const": true
          },
          "value": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "campaign",
                  "positivelyRated"
                ],
                "properties": {
                  "campaign": {
                    "$ref": "#/components/schemas/Campaign"
                  },
                  "positivelyRated": {
                    "type": "boolean"
                  }
                }
              }
            ]
          }
        }
      }
    }
  }
}
