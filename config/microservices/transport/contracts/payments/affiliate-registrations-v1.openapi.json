{
  "openapi": "3.1.0",
  "info": {
    "title": "MyScoutee internal affiliate registration",
    "version": "1.0.0",
    "description": "Accounts-only producer capability, also used before login. Resolve uses the canonical affiliate code lookup and existing owner checks. Record runs only after accounts persists profile attribution and retains the canonical insert-only upsert keyed by registered user ID. Service capability is scoped to accounts and the payments owner; no end-user or admin authority is implied. Each explicit operation preserves REAL/DEMO mode. Maximum body/resolve response 8 KiB. Record has no automatic retry: a lost reply is unknown and may be reconciled by repeating the original stored attribution with the same user ID."
  },
  "paths": {
    "/_internal/v1/payments/affiliate-registrations/resolve": {
      "post": {
        "operationId": "resolveAffiliateRegistration",
        "security": [
          {
            "serviceCapability": []
          }
        ],
        "parameters": [
          {
            "name": "X-MyScoutee-Session-Mode",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "REAL",
                "DEMO"
              ]
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Query"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Canonical resolve completed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Resolution"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request or session mode",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing/wrong service capability",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Unsupported method",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Body exceeds 4 KiB",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "JSON content type required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Resolution unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/_internal/v1/payments/affiliate-registrations/record": {
      "post": {
        "operationId": "recordAffiliateRegistration",
        "security": [
          {
            "serviceCapability": []
          }
        ],
        "parameters": [
          {
            "name": "X-MyScoutee-Session-Mode",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "REAL",
                "DEMO"
              ]
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Command"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Canonical record completed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Receipt"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request or session mode",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing/wrong service capability",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Unsupported method",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Body exceeds 4 KiB",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "JSON content type required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Registration outcome unknown; retain original stored attribution",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "serviceCapability": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Query": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 512
          },
          "userId": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 512
          }
        }
      },
      "Resolution": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "registration": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "userId"
            ],
            "properties": {
              "userId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "referrerUserId": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 512
              },
              "code": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 512
              },
              "registeredAtIso": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 512
              }
            }
          }
        }
      },
      "Command": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "registration": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "userId"
            ],
            "properties": {
              "userId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "referrerUserId": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 512
              },
              "code": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 512
              },
              "registeredAtIso": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 512
              }
            }
          }
        }
      },
      "Receipt": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "completed"
        ],
        "properties": {
          "completed": {
            "const": true
          }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "INVALID_REQUEST",
              "INVALID_SESSION_MODE",
              "UNAUTHORIZED",
              "FORBIDDEN",
              "INVALID_CONTENT_TYPE",
              "QUERY_TOO_LARGE",
              "RESOLUTION_UNAVAILABLE",
              "REGISTRATION_OUTCOME_UNKNOWN"
            ]
          }
        }
      }
    }
  }
}
