{
  "openapi": "3.1.0",
  "info": {
    "title": "MyScoutee asset-payments",
    "version": "1.0.0",
    "description": "Assets-only calls to native payment replacement validation/completion, booking records, price revisions and cancellation. REAL/DEMO and job scope preserved. No automatic retries. Missing paymentRequired never decodes as free. Native rejection status preserved. Lost mutation replies are unknown outcomes: assets must not roll back manager ownership on that assumption. Durable recovery remains milestone 16. 2 MiB request, 8 MiB response, 30 second default timeout."
  },
