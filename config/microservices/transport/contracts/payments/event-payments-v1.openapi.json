{
  "openapi": "3.1.0",
  "info": {
    "title": "MyScoutee event-payments",
    "version": "1.0.0",
    "description": "Typed calls to the existing EventPayments owner. Native validation, queries, state transitions and scheduler behavior retained. REAL/DEMO and explicit job scope; no-store. 2 MiB request / 8 MiB response bounds; no automatic retries. Payment start requires signed actor authority. Cancellation completion carries a payment ID, reloaded by the owner; no detached Payment document or cast. Lost command replies are unknown outcomes; durable recovery remains milestone 16."
  },
  "paths": {
    "/_internal/v1/payments/event-payments/pay": {
      "post": {
        "operationId": "event_payments_pay",
        "security": [
          {
            "serviceCapability": []
          }
        ],
        "parameters": [
          {
            "name": "X-MyScoutee-Session-Mode",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "REAL",
                "DEMO"
              ]
            }
          },
          {
            "name": "X-MyScoutee-Actor-Delegation",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Operation/body/mode-bound RSA proof; request user must equal verified actor."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Pay"
