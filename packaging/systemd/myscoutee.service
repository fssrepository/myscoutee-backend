[Unit]
Description=MyScoutee production stack
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
Wants=myscoutee-update-status.socket
After=myscoutee-update-status.socket

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/myscoutee/server
EnvironmentFile=-/etc/myscoutee/myscoutee.env
ExecStartPre=/opt/myscoutee/packaging/scripts/reset-demo-state.sh
ExecStartPre=/opt/myscoutee/packaging/scripts/sync-i18n-seeds.sh
ExecStart=/opt/myscoutee/packaging/scripts/myscoutee-compose.sh up -d
ExecStop=/opt/myscoutee/packaging/scripts/myscoutee-compose.sh down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
