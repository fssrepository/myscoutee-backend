# MyScoutee production compose environment.
# Installed as /etc/myscoutee/myscoutee.env and linked to /opt/myscoutee/server/.env.

MYSCOUTEE_VERSION=1.0.0

NGINX_BASE_IMAGE=myscoutee-nginx:${MYSCOUTEE_VERSION}-base
NGINX_PRODUCTION_IMAGE=myscoutee-nginx:${MYSCOUTEE_VERSION}
MYSCOUTEE_PRODUCTION_IMAGE=myscoutee-api:${MYSCOUTEE_VERSION}

MONGO_IMAGE=mongo:8.2.5
REDIS_IMAGE=redis:8.6.1-alpine
MINIO_IMAGE=minio/minio:RELEASE.2025-09-07T16-13-09Z
CERT_BOT=certbot/certbot:v5.4.0

MONGO_DEMO_DATABASE=demo_db
MONGO_REAL_DATABASE=myscoutee_db
MONGO_INITDB_DATABASE=myscoutee_db
MONGO_IMPORT_ALLOWED_COLLECTIONS_BY_DB=demo_db:*;myscoutee_db:countryPartitions

CONTAINER_TIMEZONE=Europe/Brussels
MEDIA_BUCKET=myscoutee-media
ASSET_SOURCE_REFRESH_ENABLED=true
ASSET_SOURCE_REFRESH_ALLOWED_HOSTS=booking.com,www.booking.com

FIREBASE_ENABLED=true
LETSENCRYPT_ENABLED=false
DOMAIN=myscoutee.com
WEBSOCKET_ALLOWED_ORIGIN_PATTERNS=https://myscoutee.com,https://www.myscoutee.com
