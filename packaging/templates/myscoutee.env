# MyScoutee production compose environment.
# Installed as /etc/myscoutee/myscoutee.env and linked to /opt/myscoutee/server/.env.

MYSCOUTEE_VERSION=1.0.0

NGINX_BASE_IMAGE=myscoutee-nginx:1.0.0-base
NGINX_PRODUCTION_IMAGE=myscoutee-nginx:1.0.0-prod
MYSCOUTEE_PRODUCTION_IMAGE=myscoutee-api:1.0.0-prod
MINIO_PRODUCTION_IMAGE=myscoutee-minio:1.0.0-prod

MONGO_IMAGE=mongo:8.0.4
REDIS_IMAGE=redis:8.6.1-alpine
MINIO_BASE_IMAGE=minio/minio:RELEASE.2025-09-07T16-13-09Z
CERT_BOT=certbot/certbot:v5.4.0

MONGO_DEMO_DATABASE=demo_db
MONGO_REAL_DATABASE=production_db
MONGO_INITDB_DATABASE=production_db
MONGO_IMPORT_ALLOWED_COLLECTIONS_BY_DB=demo_db:*;production_db:countryPartitions,i18n_bundles,i18n_messages,ideaPosts,helpCenterRevisions,appSettings,notificationRuleConfigs,emailTemplates,emailCampaignRules,notificationTemplates,scheduledMessageTasks,affinityConfigs,adminStats,adminMonitoring,accessPolicyDefinitions

CONTAINER_TIMEZONE=Europe/Brussels
MEDIA_BUCKET=myscoutee-media
ASSET_SOURCE_REFRESH_ENABLED=true
ASSET_SOURCE_REFRESH_ALLOWED_HOSTS=booking.com,www.booking.com

# Optional: enable this for Mongo change streams. When true, systemd adds
# docker-compose.replicaset.yml and the affinity recompute worker uses
# change-stream wakeups with polling still kept as recovery.
MONGO_REPLICA_SET_ENABLED=false
MONGO_REPLICA_SET_NAME=rs0
MONGO_REPLICA_SET_HOST=mongodb:27017
MONGO_REPLICA_SET_INIT_RETRIES=60
MONGO_REPLICA_SET_INIT_DELAY_SECONDS=2
AFFINITY_RECOMPUTE_CHANGE_STREAM_ENABLED=
AFFINITY_RECOMPUTE_CHANGE_STREAM_FALLBACK_POLL_ENABLED=true

# Central deployment registry. Installation leaves the node uninitialized and
# performs no registry communication. The future authenticated operator
# workflow sets the selected endpoint/scope and confirmation gate.
REGISTRY_ENABLED=false
REGISTRY_OUTBOUND_ALLOWED=false
REGISTRY_OPERATOR_REGISTRATION_CONFIRMED=false
REGISTRY_BASE_URL=
REGISTRY_SCOPE=
REGISTRY_PRIVATE_KEY_PATH=/etc/myscoutee/registry/deployment-private-key.pem
REGISTRY_PUBLIC_KEY_PATH=/etc/myscoutee/registry/deployment-public-key.der
REGISTRY_STATE_DIR=/var/lib/myscoutee/registry
REGISTRY_KEY_DIR_HOST=/etc/myscoutee/registry
REGISTRY_STATE_DIR_HOST=/var/lib/myscoutee/registry
REGISTRY_CONNECT_TIMEOUT=5s
REGISTRY_REQUEST_TIMEOUT=15s
REGISTRY_RETRY_DELAY=15m
REGISTRY_MAX_RESPONSE_BYTES=1048576
REGISTRY_EXPECTED_KEY_FINGERPRINT=
REGISTRY_TRUST_ON_FIRST_USE=false
REGISTRY_ALLOW_INSECURE_HTTP=false
REGISTRY_INSECURE_HTTP_ALLOWED_HOSTS=

FIREBASE_ENABLED=true
OPERATOR_USER=
LETSENCRYPT_ENABLED=false
DOMAIN=myscoutee.com
WEBSOCKET_ALLOWED_ORIGIN_PATTERNS=https://myscoutee.com,https://www.myscoutee.com,http://localhost:8080,http://127.0.0.1:8080
