#!/usr/bin/env bash
set -euo pipefail

cleanup_generated_opt_paths() {
  # The TLS pair is mutable operator state. Normal removal, deconfiguration,
  # and reinstall must preserve it; an explicit package purge owns deletion.
  if [[ -L /opt/myscoutee/server/data ]]; then
    rm -f /opt/myscoutee/server/data
  fi

  rmdir /opt/myscoutee/server/docker/conf/nginx/keys >/dev/null 2>&1 || true
  rmdir /opt/myscoutee/server/docker/conf/nginx >/dev/null 2>&1 || true
}

if [[ "${1:-}" = "remove" || "${1:-}" = "deconfigure" ]]; then
  if command -v systemctl >/dev/null 2>&1; then
    systemctl stop myscoutee-update.path myscoutee-update.service >/dev/null 2>&1 || true
    systemctl stop myscoutee-update-status.socket myscoutee-update-status.service >/dev/null 2>&1 || true
    systemctl disable myscoutee-update-status.socket >/dev/null 2>&1 || true
    systemctl stop myscoutee-tls.path myscoutee-tls.service myscoutee-tls-renew.timer myscoutee-tls-renew.service >/dev/null 2>&1 || true
    systemctl disable myscoutee-update.path >/dev/null 2>&1 || true
    systemctl disable myscoutee-tls.path myscoutee-tls-renew.timer >/dev/null 2>&1 || true
    systemctl stop myscoutee.service >/dev/null 2>&1 || true
    systemctl disable myscoutee.service >/dev/null 2>&1 || true
  fi

  cleanup_generated_opt_paths
fi
