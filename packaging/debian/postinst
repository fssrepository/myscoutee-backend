#!/usr/bin/env bash
set -euo pipefail

case "${1:-}" in
  configure)
    ;;
  abort-upgrade|abort-remove|abort-deconfigure)
    # A failed package transition must not rerun the full deployment
    # configuration path as a recovery side effect.
    exit 0
    ;;
  *)
    echo "Unsupported MyScoutee postinst action: ${1:-missing}" >&2
    exit 1
    ;;
esac

MYSCOUTEE_API_UID=10001
MYSCOUTEE_API_GID=10001

printf '[myscoutee-update-phase] CONFIGURING_PACKAGE\n'

# The host reader uses the same numeric ownership as the application. Register
# a real non-login system identity rather than relying on an unknown numeric user.
systemd-sysusers /usr/lib/sysusers.d/myscoutee.conf
if [[ "$(id -u myscoutee-runtime)" != "${MYSCOUTEE_API_UID}" \
   || "$(id -g myscoutee-runtime)" != "${MYSCOUTEE_API_GID}" ]]; then
  echo "MyScoutee runtime UID/GID10001 is already reserved by another account." >&2
  exit 1
fi

install_numeric_owned_directory() {
  local mode="$1"
  local owner_uid="$2"
  local owner_gid="$3"
  shift 3

  [[ "${owner_uid}" =~ ^[0-9]+$ && "${owner_gid}" =~ ^[0-9]+$ ]] || {
    echo "MyScoutee directory ownership must use numeric IDs." >&2
    return 1
  }
  install -d -m "${mode}" -- "$@"
  chown "+${owner_uid}:+${owner_gid}" -- "$@"
  chmod "${mode}" -- "$@"
}

install -d -m 0755 /etc/myscoutee
install_numeric_owned_directory \
  0750 0 "${MYSCOUTEE_API_GID}" /etc/myscoutee/configuration
install_numeric_owned_directory \
  0700 "${MYSCOUTEE_API_UID}" "${MYSCOUTEE_API_GID}" /etc/myscoutee/registry
install -d -m 0755 /opt/myscoutee/server
install -d -m 0755 /opt/myscoutee/server/docker/conf/nginx/keys
install -d -m 0755 /opt/myscoutee/server/projects/profile/secrets
install -d -m 0755 /var/lib/myscoutee/data
install_numeric_owned_directory \
  0700 "${MYSCOUTEE_API_UID}" "${MYSCOUTEE_API_GID}" /var/lib/myscoutee/registry
install -d -m 0700 /var/lib/myscoutee/update
install -d -m 0700 /var/lib/myscoutee/update/inbox
install_numeric_owned_directory \
  0700 "${MYSCOUTEE_API_UID}" "${MYSCOUTEE_API_GID}" \
  /var/lib/myscoutee/update/inbox/requests \
  /var/lib/myscoutee/update/inbox/staging
install -d -m 0700 /var/lib/myscoutee/update/archive
install -d -m 0700 /var/lib/myscoutee/update/archive/processing
install -d -m 0700 /var/lib/myscoutee/update/archive/completed
install -d -m 0700 /var/lib/myscoutee/update/archive/failed
install -d -m 0700 /var/lib/myscoutee/update/archive/rejected
install_numeric_owned_directory 0750 0 "${MYSCOUTEE_API_GID}" /var/lib/myscoutee/update/runtime
install_numeric_owned_directory \
  0750 0 "${MYSCOUTEE_API_GID}" \
  /var/lib/myscoutee/update/runtime/jobs \
  /etc/myscoutee/update
install -d -m 0700 /var/cache/myscoutee-update
install -d -m 0700 /var/cache/myscoutee-update/jobs
install -d -m 0755 /var/log/myscoutee
install -d -m 0700 /var/log/myscoutee/update
install -d -m 0700 /var/lib/myscoutee/tls
install -d -m 0700 /var/lib/myscoutee/tls/inbox
install_numeric_owned_directory \
  0700 "${MYSCOUTEE_API_UID}" "${MYSCOUTEE_API_GID}" \
  /var/lib/myscoutee/tls/inbox/requests
install -d -m 0700 /var/lib/myscoutee/tls/archive
install -d -m 0700 /var/lib/myscoutee/tls/archive/processing
install_numeric_owned_directory \
  0750 0 "${MYSCOUTEE_API_GID}" /var/lib/myscoutee/tls/runtime
install_numeric_owned_directory \
  2750 0 "${MYSCOUTEE_API_GID}" /var/lib/myscoutee/tls/runtime/jobs
install -d -m 0755 /var/lib/myscoutee/data/certbot/conf
install -d -m 0755 /var/lib/myscoutee/data/certbot/www
install -d -m 0755 /var/backups/myscoutee
install -m 0644 \
  /opt/myscoutee/packaging/update/README \
  /etc/myscoutee/update/README

MYSCOUTEE_CONFIGURATION_OWNER_UID=0 \
MYSCOUTEE_CONFIGURATION_OWNER_GID="${MYSCOUTEE_API_GID}" \
  /opt/myscoutee/packaging/scripts/ensure-operator-configuration-key.sh

# Migrate preserved registry identity/state to the unprivileged production API
# user. Symlinks are not followed.
chown -R --no-dereference \
  "+${MYSCOUTEE_API_UID}:+${MYSCOUTEE_API_GID}" \
  /etc/myscoutee/registry \
  /var/lib/myscoutee/registry
if [[ -f /etc/myscoutee/update/release-public-key.pem \
  && ! -L /etc/myscoutee/update/release-public-key.pem ]]; then
  chown "+0:+${MYSCOUTEE_API_GID}" -- \
    /etc/myscoutee/update/release-public-key.pem
  chmod 0640 /etc/myscoutee/update/release-public-key.pem
fi
if [[ -f /etc/myscoutee/firebase-service-account.json \
  && ! -L /etc/myscoutee/firebase-service-account.json ]]; then
  chown "+0:+${MYSCOUTEE_API_GID}" -- \
    /etc/myscoutee/firebase-service-account.json
  chmod 0640 /etc/myscoutee/firebase-service-account.json
fi

generate_secret() {
  if command -v openssl >/dev/null 2>&1; then
    openssl rand -hex 32
    return 0
  fi

  if [[ -r /dev/urandom ]]; then
    LC_ALL=C od -An -N32 -tx1 /dev/urandom | tr -d ' \n'
    return 0
  fi

  echo "Unable to generate production secrets: openssl is missing and /dev/urandom is unavailable." >&2
  exit 1
}

ensure_bootstrap_tls_pair() {
  local certificate_path="$1"
  local private_key_path="$2"
  local certificate_exists=false
  local private_key_exists=false
  local certificate_directory
  local private_key_directory
  local temporary_directory

  if [[ -e "${certificate_path}" || -L "${certificate_path}" ]]; then
    certificate_exists=true
  fi
  if [[ -e "${private_key_path}" || -L "${private_key_path}" ]]; then
    private_key_exists=true
  fi

  if [[ "${certificate_exists}" == true \
    && "${private_key_exists}" == true ]]; then
    return 0
  fi

  if [[ "${certificate_exists}" != "${private_key_exists}" ]]; then
    echo "A partial operator-managed TLS configuration was found." >&2
    echo "Preserving the existing certificate or private key without replacement." >&2
    echo "Restore the missing counterpart, or explicitly remove the remaining file before reconfiguring the package:" >&2
    echo "  certificate: ${certificate_path}" >&2
    echo "  private key: ${private_key_path}" >&2
    return 1
  fi

  if ! command -v openssl >/dev/null 2>&1; then
    echo "openssl is missing; cannot create the initial localhost TLS certificate." >&2
    return 1
  fi

  certificate_directory="$(dirname -- "${certificate_path}")"
  private_key_directory="$(dirname -- "${private_key_path}")"
  if [[ "${certificate_directory}" != "${private_key_directory}" ]]; then
    echo "The bootstrap TLS certificate and private key must use the same directory." >&2
    return 1
  fi

  temporary_directory="$(
    mktemp -d "${certificate_directory}/.myscoutee-bootstrap-tls.XXXXXX"
  )"
  if ! openssl req -x509 -nodes -days 3650 -newkey rsa:2048 \
      -keyout "${temporary_directory}/nginx-nopass.key" \
      -out "${temporary_directory}/nginx.crt" \
      -subj "/CN=localhost" \
      -sha256 \
      -addext "subjectAltName=DNS:localhost,IP:127.0.0.1" \
      >/dev/null 2>&1; then
    rm -rf -- "${temporary_directory}"
    echo "Failed to create the initial localhost TLS certificate." >&2
    return 1
  fi
  chmod 0600 "${temporary_directory}/nginx-nopass.key"
  chmod 0644 "${temporary_directory}/nginx.crt"

  if [[ -e "${certificate_path}" || -L "${certificate_path}" \
    || -e "${private_key_path}" || -L "${private_key_path}" ]]; then
    rm -rf -- "${temporary_directory}"
    echo "TLS files appeared while the bootstrap pair was being generated; preserving them without replacement." >&2
    return 1
  fi

  mv -- "${temporary_directory}/nginx-nopass.key" "${private_key_path}"
  mv -- "${temporary_directory}/nginx.crt" "${certificate_path}"
  rmdir -- "${temporary_directory}"
}

install_generated_secrets_file() {
  local target template tmp
  local mongo_root_password mongo_app_password minio_root_password
  local simulator_api_key simulator_webhook_secret simulator_barion_pos_key

  target="/etc/myscoutee/myscoutee.secrets.env"
  template="/opt/myscoutee/packaging/templates/myscoutee.secrets.env"

  mongo_root_password="$(generate_secret)"
  mongo_app_password="$(generate_secret)"
  minio_root_password="$(generate_secret)"
  simulator_api_key="sk_test_$(generate_secret)"
  simulator_webhook_secret="whsec_$(generate_secret)"
  simulator_barion_pos_key="$(generate_guid)"

  tmp="$(mktemp "${target}.XXXXXX")"
  chmod 0600 "${tmp}"

  sed \
    -e "s/^MONGO_INITDB_ROOT_PASSWORD=.*/MONGO_INITDB_ROOT_PASSWORD=${mongo_root_password}/" \
    -e "s/^MONGO_APP_PASSWORD=.*/MONGO_APP_PASSWORD=${mongo_app_password}/" \
    -e "s/^MINIO_ROOT_PASSWORD=.*/MINIO_ROOT_PASSWORD=${minio_root_password}/" \
    -e "s/^PAYMENT_SIMULATOR_API_KEY=.*/PAYMENT_SIMULATOR_API_KEY=${simulator_api_key}/" \
    -e "s/^PAYMENT_SIMULATOR_WEBHOOK_SECRET=.*/PAYMENT_SIMULATOR_WEBHOOK_SECRET=${simulator_webhook_secret}/" \
    -e "s/^PAYMENT_SIMULATOR_BARION_POS_KEY=.*/PAYMENT_SIMULATOR_BARION_POS_KEY=${simulator_barion_pos_key}/" \
    "${template}" > "${tmp}"

  install -m 0600 "${tmp}" "${target}"
  rm -f "${tmp}"
}

generate_guid() {
  local random

  random="$(generate_secret)"
  printf '%s-%s-4%s-8%s-%s' \
    "${random:0:8}" \
    "${random:8:4}" \
    "${random:13:3}" \
    "${random:17:3}" \
    "${random:20:12}"
}

read_env_file_value() {
  local key="$1"
  local file="$2"
  local line value

  [[ -f "${file}" ]] || return 1
  line="$(sed -n "s/^[[:space:]]*${key}[[:space:]]*=[[:space:]]*//p" "${file}" | tail -n 1)"
  [[ -n "${line}" ]] || return 1

  value="${line%$'\r'}"
  if [[ "${value}" == \"*\" && "${value}" == *\" ]]; then
    value="${value:1:${#value}-2}"
  elif [[ "${value}" == \'*\' && "${value}" == *\' ]]; then
    value="${value:1:${#value}-2}"
  fi

  printf '%s' "${value}"
}

config_value() {
  local key="$1"
  local fallback="$2"
  local value

  value="$(read_env_file_value "${key}" /etc/myscoutee/myscoutee.env || true)"
  if [[ -n "${value}" ]]; then
    printf '%s' "${value}"
    return 0
  fi

  printf '%s' "${fallback}"
}

upsert_env_value() {
  local file="$1"
  local key="$2"
  local value="$3"

  if grep -q "^[[:space:]]*${key}[[:space:]]*=" "${file}"; then
    sed -i "s|^[[:space:]]*${key}[[:space:]]*=.*|${key}=${value}|" "${file}"
    return 0
  fi

  printf '\n%s=%s\n' "${key}" "${value}" >> "${file}"
}

ensure_env_default() {
  local file="$1"
  local key="$2"
  local value="$3"

  if ! grep -q "^[[:space:]]*${key}[[:space:]]*=" "${file}"; then
    printf '\n%s=%s\n' "${key}" "${value}" >> "${file}"
  fi
}

ensure_generated_secret() {
  local file="$1"
  local key="$2"
  local value="$3"
  local current

  current="$(read_env_file_value "${key}" "${file}" || true)"
  if [[ -z "${current}" ]]; then
    upsert_env_value "${file}" "${key}" "${value}"
  fi
}

ensure_mongo_seed_allow_list() {
  local file current updated required_collections collection

  file="/etc/myscoutee/myscoutee.env"
  required_collections="emailTemplates,emailCampaignRules,notificationTemplates,scheduledMessageTasks,operatorRegistryEndpoints,paymentProviders,deploymentConfigurations"
  current="$(read_env_file_value MONGO_IMPORT_ALLOWED_COLLECTIONS_BY_DB "${file}" || true)"

  if [[ -z "${current}" ]]; then
    upsert_env_value "${file}" MONGO_IMPORT_ALLOWED_COLLECTIONS_BY_DB "demo_db:*;production_db:countryPartitions,i18n_bundles,i18n_messages,ideaPosts,helpCenterRevisions,appSettings,notificationRuleConfigs,${required_collections},affinityConfigs,adminStats,adminMonitoring,accessPolicyDefinitions"
    return 0
  fi

  for collection in \
    emailTemplates emailCampaignRules notificationTemplates \
    scheduledMessageTasks operatorRegistryEndpoints paymentProviders \
    deploymentConfigurations; do
    if [[ "${current}" != *"${collection}"* ]]; then
      updated="${current/notificationRuleConfigs/notificationRuleConfigs,${required_collections}}"
      if [[ "${updated}" == "${current}" ]]; then
        updated="${current};production_db:${required_collections}"
      fi
      upsert_env_value "${file}" MONGO_IMPORT_ALLOWED_COLLECTIONS_BY_DB "${updated}"
      return 0
    fi
  done
}

normalize_packaged_image_values() {
  local env_file packaged_version

  env_file="/etc/myscoutee/myscoutee.env"
  packaged_version="$(sed -n '1p' /opt/myscoutee/packaging/VERSION 2>/dev/null || true)"
  if [[ ! "${packaged_version}" =~ ^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(-qa\.[1-9][0-9]*)?$ ]] \
    || ! dpkg --validate-version "${packaged_version}" >/dev/null 2>&1; then
    echo "The installed package version marker is missing or invalid." >&2
    exit 1
  fi
  upsert_env_value "${env_file}" NGINX_BASE_IMAGE \
    "myscoutee-nginx:${packaged_version}-base"
  upsert_env_value "${env_file}" NGINX_PRODUCTION_IMAGE \
    "myscoutee-nginx:${packaged_version}-prod"
  upsert_env_value "${env_file}" MYSCOUTEE_PRODUCTION_IMAGE \
    "myscoutee-api:${packaged_version}-prod"
  upsert_env_value "${env_file}" MINIO_PRODUCTION_IMAGE \
    "myscoutee-minio:${packaged_version}-prod"
  upsert_env_value "${env_file}" REGISTRY_DEMO_IMAGE \
    "myscoutee-registry:${packaged_version}-prod"
  upsert_env_value "${env_file}" PAYMENT_SIMULATOR_IMAGE \
    "myscoutee-payment-simulator:${packaged_version}-prod"
  upsert_env_value "${env_file}" MYSCOUTEE_VERSION "${packaged_version}"
}

normalize_packaged_image_value() {
  local env_file="$1"
  local key="$2"
  local expected="$3"
  local current legacy escaped

  shift 3
  current="$(read_env_file_value "${key}" "${env_file}" || true)"
  [[ -n "${current}" ]] || return 0
  [[ "${current}" != "${expected}" ]] || return 0

  for legacy in "$@"; do
    if [[ "${current}" == "${legacy}" ]]; then
      escaped="${expected//\\/\\\\}"
      escaped="${escaped//&/\\&}"
      sed -i "s|^[[:space:]]*${key}[[:space:]]*=.*|${key}=${escaped}|" "${env_file}"
      return 0
    fi
  done
}

ensure_docker_image() {
  local image="$1"
  local label="$2"

  if docker image inspect "${image}" >/dev/null 2>&1; then
    echo "${label} image is available: ${image}"
    return 0
  fi

  echo "Pulling ${label} image: ${image}"
  docker pull "${image}"
}

ensure_service_images() {
  ensure_docker_image "$(config_value MONGO_IMAGE mongo:8.0.4)" "MongoDB"
  ensure_docker_image "$(config_value REDIS_IMAGE redis:8.6.1-alpine)" "Redis"
}

verify_packaged_image_manifest() {
  local fingerprint_helper manifest version reference expected_fingerprint
  local actual_fingerprint
  local -a images=()

  fingerprint_helper="/opt/myscoutee/packaging/scripts/image-content-fingerprint.sh"
  manifest="/opt/myscoutee/packaging/IMAGE-MANIFEST.json"
  version="$(sed -n '1p' /opt/myscoutee/packaging/VERSION)"
  if [[ ! -f "${fingerprint_helper}" || -L "${fingerprint_helper}" ]] \
    || [[ ! -f "${manifest}" || -L "${manifest}" ]] \
    || ! jq -e --arg version "${version}" '
      .schemaVersion == 1
      and .releaseVersion == $version
      and .bundled == true
      and (.images | type == "array" and length == 6)
      and ([.images[].service] | sort
        == ["minio", "nginx", "nginx-base", "payment-simulator", "profilemanagement", "registry-demo"])
      and all(.images[];
        (.reference | type == "string")
        and (.imageId | test("^sha256:[0-9a-f]{64}$"))
        and (.contentFingerprint | test("^sha256:[0-9a-f]{64}$")))
    ' "${manifest}" >/dev/null; then
    echo "The package bundled-image manifest is missing or invalid." >&2
    exit 1
  fi

  mapfile -t images < <(
    jq -r '.images[] | [.reference, .contentFingerprint] | @tsv' "${manifest}"
  )
  for image in "${images[@]}"; do
    IFS=$'\t' read -r reference expected_fingerprint <<< "${image}"
    actual_fingerprint="$(
      bash "${fingerprint_helper}" docker "${reference}" 2>/dev/null || true
    )"
    if [[ "${actual_fingerprint}" != "${expected_fingerprint}" ]]; then
      echo "Bundled image content mismatch for ${reference}." >&2
      exit 1
    fi
  done
}

if [[ ! -f /etc/myscoutee/myscoutee.env ]]; then
  install -m 0644 /opt/myscoutee/packaging/templates/myscoutee.env /etc/myscoutee/myscoutee.env
fi

ensure_env_default /etc/myscoutee/myscoutee.env REGISTRY_ENABLED false
ensure_env_default /etc/myscoutee/myscoutee.env REGISTRY_OUTBOUND_ALLOWED false
ensure_env_default /etc/myscoutee/myscoutee.env REGISTRY_OPERATOR_REGISTRATION_CONFIRMED false
ensure_env_default /etc/myscoutee/myscoutee.env REGISTRY_BASE_URL ""
ensure_env_default /etc/myscoutee/myscoutee.env REGISTRY_SCOPE ""
ensure_env_default /etc/myscoutee/myscoutee.env REGISTRY_PRIVATE_KEY_PATH /etc/myscoutee/registry/deployment-private-key.pem
ensure_env_default /etc/myscoutee/myscoutee.env REGISTRY_PUBLIC_KEY_PATH /etc/myscoutee/registry/deployment-public-key.der
ensure_env_default /etc/myscoutee/myscoutee.env REGISTRY_STATE_DIR /var/lib/myscoutee/registry
ensure_env_default /etc/myscoutee/myscoutee.env REGISTRY_KEY_DIR_HOST /etc/myscoutee/registry
ensure_env_default /etc/myscoutee/myscoutee.env REGISTRY_STATE_DIR_HOST /var/lib/myscoutee/registry
ensure_env_default /etc/myscoutee/myscoutee.env REGISTRY_CONNECT_TIMEOUT 5s
ensure_env_default /etc/myscoutee/myscoutee.env REGISTRY_REQUEST_TIMEOUT 15s
ensure_env_default /etc/myscoutee/myscoutee.env REGISTRY_RETRY_DELAY 15m
ensure_env_default /etc/myscoutee/myscoutee.env REGISTRY_MAX_RESPONSE_BYTES 1048576
ensure_env_default /etc/myscoutee/myscoutee.env REGISTRY_EXPECTED_KEY_FINGERPRINT ""
ensure_env_default /etc/myscoutee/myscoutee.env REGISTRY_TRUST_ON_FIRST_USE false
ensure_env_default /etc/myscoutee/myscoutee.env REGISTRY_ALLOW_INSECURE_HTTP false
ensure_env_default /etc/myscoutee/myscoutee.env REGISTRY_INSECURE_HTTP_ALLOWED_HOSTS ""
ensure_env_default /etc/myscoutee/myscoutee.env REGISTRY_DEMO_BASE_URL http://registry:8080
ensure_env_default /etc/myscoutee/myscoutee.env REGISTRY_DEMO_SCOPE demo:myscoutee
ensure_env_default /etc/myscoutee/myscoutee.env REGISTRY_DEMO_PRIVATE_KEY_PATH /var/lib/myscoutee/registry-demo/keys/deployment-private-key.pem
ensure_env_default /etc/myscoutee/myscoutee.env REGISTRY_DEMO_PUBLIC_KEY_PATH /var/lib/myscoutee/registry-demo/keys/deployment-public-key.der
ensure_env_default /etc/myscoutee/myscoutee.env REGISTRY_DEMO_STATE_DIR /var/lib/myscoutee/registry-demo/state
ensure_env_default /etc/myscoutee/myscoutee.env REGISTRY_DEMO_ALLOW_INSECURE_HTTP true
ensure_env_default /etc/myscoutee/myscoutee.env REGISTRY_DEMO_INSECURE_HTTP_ALLOWED_HOSTS registry
ensure_env_default /etc/myscoutee/myscoutee.env REGISTRY_DEMO_VOLUME_NAME myscoutee-registry-demo-data-v1
ensure_env_default /etc/myscoutee/myscoutee.env REGISTRY_DEMO_CLIENT_VOLUME_NAME myscoutee-registry-demo-client-data-v1
ensure_env_default /etc/myscoutee/myscoutee.env PAYMENT_SIMULATOR_PUBLIC_BASE_URL https://localhost
ensure_env_default /etc/myscoutee/myscoutee.env PAYMENT_SIMULATOR_APPLICATION_BASE_URL https://localhost
ensure_env_default /etc/myscoutee/myscoutee.env PAYMENT_SIMULATOR_BARION_MERCHANT_ACCOUNT merchant@myscoutee.invalid
ensure_env_default /etc/myscoutee/myscoutee.env PAYMENT_SIMULATOR_VOLUME_NAME myscoutee-payment-simulator-data-v1
ensure_env_default /etc/myscoutee/myscoutee.env OPERATOR_CONFIGURATION_MASTER_KEY_PATH /etc/myscoutee/configuration/deployment-master-key
ensure_env_default /etc/myscoutee/myscoutee.env OPERATOR_CONFIGURATION_KEY_DIR_HOST /etc/myscoutee/configuration
ensure_env_default /etc/myscoutee/myscoutee.env MYSCOUTEE_UPDATE_ENABLED false
ensure_env_default /etc/myscoutee/myscoutee.env MYSCOUTEE_UPDATE_CACHE_DIR /var/cache/myscoutee-update
ensure_env_default /etc/myscoutee/myscoutee.env MYSCOUTEE_UPDATE_AUDIT_DIR /var/log/myscoutee/update
ensure_env_default /etc/myscoutee/myscoutee.env MYSCOUTEE_UPDATE_RELEASE_PUBLIC_KEY /etc/myscoutee/update/release-public-key.pem
ensure_env_default /etc/myscoutee/myscoutee.env MYSCOUTEE_UPDATE_MAX_ARTIFACT_BYTES 4294967296
ensure_env_default /etc/myscoutee/myscoutee.env MYSCOUTEE_UPDATE_STAGING_SAFETY_RESERVE_BYTES 536870912
ensure_env_default /etc/myscoutee/myscoutee.env MYSCOUTEE_UPDATE_MIN_FREE_BYTES 536870912
ensure_env_default /etc/myscoutee/myscoutee.env MYSCOUTEE_UPDATE_HEALTH_TIMEOUT_SECONDS 300
ensure_env_default /etc/myscoutee/myscoutee.env MYSCOUTEE_UPDATE_CACHE_RETENTION_JOBS 2
ensure_env_default /etc/myscoutee/myscoutee.env FIREBASE_ENABLED false

ensure_mongo_seed_allow_list

normalize_packaged_image_values

firebase_enabled="$(config_value FIREBASE_ENABLED false)"
if [[ -L /etc/myscoutee/firebase-service-account.json ]]; then
  echo "Firebase service-account path must not be a symbolic link." >&2
  exit 1
elif [[ ! -f /etc/myscoutee/firebase-service-account.json ]]; then
  if [[ "${firebase_enabled,,}" == "true" ]]; then
    echo "Firebase is enabled, but /etc/myscoutee/firebase-service-account.json is missing." >&2
    exit 1
  fi
  printf '{}\n' > /etc/myscoutee/firebase-service-account.json
fi
chown "+0:+${MYSCOUTEE_API_GID}" -- \
  /etc/myscoutee/firebase-service-account.json
chmod 0640 /etc/myscoutee/firebase-service-account.json

if ! grep -q '^[[:space:]]*MONGO_REPLICA_SET_ENABLED=' /etc/myscoutee/myscoutee.env; then
  cat >> /etc/myscoutee/myscoutee.env <<'EOF'

# Optional: enable this for Mongo change streams. When true, systemd adds
# docker-compose.replicaset.yml and the affinity recompute worker uses
# change-stream wakeups with polling still kept as recovery.
MONGO_REPLICA_SET_ENABLED=false
MONGO_REPLICA_SET_NAME=rs0
MONGO_REPLICA_SET_HOST=mongodb:27017
MONGO_REPLICA_SET_INIT_RETRIES=60
MONGO_REPLICA_SET_INIT_DELAY_SECONDS=2
AFFINITY_RECOMPUTE_CHANGE_STREAM_ENABLED=
AFFINITY_RECOMPUTE_CHANGE_STREAM_FALLBACK_POLL_ENABLED=true
EOF
fi

if [[ ! -f /etc/myscoutee/myscoutee.secrets.env ]]; then
  install_generated_secrets_file
fi

ensure_generated_secret \
  /etc/myscoutee/myscoutee.secrets.env \
  PAYMENT_SIMULATOR_API_KEY \
  "sk_test_$(generate_secret)"
ensure_generated_secret \
  /etc/myscoutee/myscoutee.secrets.env \
  PAYMENT_SIMULATOR_WEBHOOK_SECRET \
  "whsec_$(generate_secret)"
ensure_generated_secret \
  /etc/myscoutee/myscoutee.secrets.env \
  PAYMENT_SIMULATOR_BARION_POS_KEY \
  "$(generate_guid)"
chmod 0600 /etc/myscoutee/myscoutee.secrets.env

MYSCOUTEE_BOOTSTRAP_ENV_FILE=/etc/myscoutee/myscoutee.env \
MYSCOUTEE_BOOTSTRAP_SECRETS_FILE=/etc/myscoutee/myscoutee.secrets.env \
MYSCOUTEE_BOOTSTRAP_OWNER_UID=0 \
MYSCOUTEE_BOOTSTRAP_OWNER_GID=0 \
  /opt/myscoutee/packaging/scripts/ensure-operator-bootstrap.sh

ln -sfn /etc/myscoutee/myscoutee.env /opt/myscoutee/server/.env
ln -sfn /etc/myscoutee/myscoutee.secrets.env /opt/myscoutee/server/.env.secrets

if [[ ! -e /opt/myscoutee/server/data ]]; then
  ln -sfn /var/lib/myscoutee/data /opt/myscoutee/server/data
fi

ensure_bootstrap_tls_pair \
  /opt/myscoutee/server/docker/conf/nginx/keys/nginx.crt \
  /opt/myscoutee/server/docker/conf/nginx/keys/nginx-nopass.key

if command -v docker >/dev/null 2>&1 && command -v systemctl >/dev/null 2>&1; then
  systemctl enable --now docker
fi

if ! command -v docker >/dev/null 2>&1; then
  echo "Docker is required. Install the local deb with apt so dependencies are installed: apt install ./myscoutee_1.0.0_amd64.deb" >&2
  exit 1
fi

if ! docker compose version >/dev/null 2>&1; then
  echo "Docker Compose v2 is required. Install the local deb with apt so dependencies are installed: apt install ./myscoutee_1.0.0_amd64.deb" >&2
  exit 1
fi

if ! docker info >/dev/null 2>&1; then
  echo "Docker is installed, but the Docker daemon is not reachable. Start docker.service and rerun package configuration." >&2
  exit 1
fi

printf '[myscoutee-update-phase] LOADING_IMAGES\n'
if compgen -G "/opt/myscoutee/images/*.tar" >/dev/null; then
  for image_archive in /opt/myscoutee/images/*.tar; do
    echo "Loading bundled Docker image: ${image_archive}"
    docker load -i "${image_archive}" >/dev/null
  done
fi

printf '[myscoutee-update-phase] VERIFYING_IMAGES\n'
verify_packaged_image_manifest
ensure_service_images

# Every package configuration invalidates the disposable Explore dataset. The
# next service start consumes this marker and cleanly rebuilds demo_db plus the
# package-owned demo MinIO prefixes. Production data and user uploads are never
# reset by this lifecycle.
printf '%s\n' "$(sed -n '1p' /opt/myscoutee/packaging/VERSION)" \
  > /var/lib/myscoutee/demo-reset-required
chmod 0600 /var/lib/myscoutee/demo-reset-required

if command -v systemctl >/dev/null 2>&1; then
  systemctl daemon-reload || true
  if systemctl is-active --quiet myscoutee.service; then
    /opt/myscoutee/packaging/scripts/sync-i18n-seeds.sh
  fi
  systemctl enable myscoutee.service >/dev/null 2>&1 || true
  systemctl enable --now myscoutee-update-status.socket
  systemctl try-restart myscoutee-update-status.service
  systemctl enable --now myscoutee-update.path >/dev/null 2>&1 || true
  systemctl enable --now myscoutee-tls.path >/dev/null 2>&1 || true
  systemctl enable --now myscoutee-tls-renew.timer >/dev/null 2>&1 || true
fi

cat <<'MESSAGE'
MyScoutee is installed.

Before first start:
  1. Save the shown-once deployment-local Operator credential printed above,
     or review the OPERATOR_USER identity you supplied before installation
  2. Review /etc/myscoutee/myscoutee.secrets.env (Mongo and MinIO passwords are generated on first install)
  3. Run: systemctl start myscoutee

No production administrator email is packaged. After the initial Operator
login, configure Firebase and the deployment's administrator emails in the
Operator Configuration screen.

The bootstrap password is never deliberately persisted or printed again. Its
generated subject and SHA-256 hash are kept in the root-only secrets file. The
shown-once terminal output may be retained by package-manager or automation
logs, so protect those logs. The password itself is not single-use: this local
credential remains available for ongoing Operator login until it is explicitly
replaced or disabled, and configuring Firebase does not automatically replace
it.

Registry participation is not selected during installation. The authenticated
operator workflow inspects a chosen registry, requests explicit confirmation,
and only then initializes the local node identity and registers it.
MESSAGE
