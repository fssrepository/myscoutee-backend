/**/mysql
/**/certs

/**/BL_proxy

# compiled output
/**/dist
packaging/dist/
/**/dist-server
/**/tmp
/**/out-tsc
/**/bin

/**/server/data

# dependencies
/**/node_modules
/**/.angular

# IDEs and editors
.idea
.project
.classpath
.c9/
*.launch
/**/.settings
*.sublime-workspace

# misc
.sass-cache
.e2e-artifacts/
.trust-mode.local
connect.lock
coverage
libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/**/typings

# Keep rejected and backup media out of Git. Approved/current renders may be
# committed deliberately; filenames containing these markers remain local.
**/renders/**/*rejected*
**/renders/**/*discarded*
**/renders/**/*superseded*
**/renders/**/backups/
**/renders/**/archive/
**/renders/**/*.bak
**/renders/**/*.orig
**/renders/**/*.tmp

# e2e
#/**/e2e/*.js
#/**/e2e/*.map

# System Files
.DS_Store
Thumbs.db

/**/CMakeFiles
/**/CMakeCache.txt
/**/cmake_install.cmake

/server/docker/conf/nginx/app/myscoutee/.frontend-ready

# local secrets
/server/.env.secret
/server/.env.secrets
/frontend/src/secrets/keys.ts
/server/projects/profile/secrets/application-dev-secrets.yaml
/server/projects/profile/secrets/firebase-service-account.json
/server/projects/profile/secrets/*.json
/server/projects/profile/secrets/*.yaml
/server/projects/profile/secrets/*.yml
!/server/projects/profile/secrets/README.md
/server/docker/conf/nginx/keys/*.key
/server/docker/conf/nginx/keys/*.crt
!/server/docker/conf/nginx/keys/README.md

# local target deploy configs
/packaging/client-tools/*.env
/server/docker/.qa-mobile-runtime/
