# See http://help.github.com/ignore-files/ for more about ignoring files.

/**/.gradle
/**/.gradle-docker
/**/build
/**/.idea
/**/target

/**/srv
/**/qm1data
/**/mysql
/**/certs

/**/BL_proxy

# compiled output
/**/dist
/**/dist-server
/**/tmp
/**/out-tsc
/**/bin

/**/server/data

# dependencies
/**/node_modules
/**/.angular

# IDEs and editors
.idea
.project
.classpath
.c9/
*.launch
/**/.settings
*.sublime-workspace

# misc
.sass-cache
.e2e-artifacts/
.trust-mode.local
server/.env.mongo-root.local
connect.lock
coverage
libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/**/typings

# Keep rejected and backup media out of Git. Approved/current renders may be
# committed deliberately; filenames containing these markers remain local.
**/renders/**/*rejected*
**/renders/**/*discarded*
**/renders/**/*superseded*
**/renders/**/backups/
**/renders/**/archive/
**/renders/**/*.bak
**/renders/**/*.orig
**/renders/**/*.tmp

# e2e
#/**/e2e/*.js
#/**/e2e/*.map

# System Files
.DS_Store
Thumbs.db

/**/CMakeFiles
/**/CMakeCache.txt
/**/cmake_install.cmake

# Generated dev frontend copied by server/docker/scripts/sync_frontend_assets.sh.
# Keep this shared exclusion in the repository rather than .git/info/exclude.
# Deliberate snapshots can be added with git add -f. Afterwards untrack them
# with git rm -r --cached so normal development keeps ignoring generated output.
/server/docker/conf/nginx/app/myscoutee/

# local secrets
*-firebase-adminsdk-*.json
/server/.env.secret
/server/.env.secrets
/frontend/src/secrets/keys.ts
/server/projects/profile/secrets/application-dev-secrets.yaml
/server/projects/profile/secrets/firebase-service-account.json
/server/projects/profile/secrets/*.json
/server/projects/profile/secrets/*.yaml
/server/projects/profile/secrets/*.yml
!/server/projects/profile/secrets/README.md
/server/docker/conf/nginx/keys/*.key
/server/docker/conf/nginx/keys/*.crt
!/server/docker/conf/nginx/keys/README.md

# local target deploy configs
/config/packaging/client-tools/*.env
/server/docker/.qa-mobile-runtime/


# Python command modules used by source-only seed/release tools.
/tools/seeds/__pycache__/
/tools/traffic/__pycache__/

# Project-specific microservices inputs and generated/private tool outputs.
server/build/microservices/
tools/microservices/__pycache__/
config/microservices/**/*.local.env

# Publication builder intermediates; released PDF/PPTX stay versioned.
/guides/publication/presentations/**/slides/
/guides/publication/presentations/**/assets/
/guides/publication/presentations/**/contact-sheet.png
/guides/publication/presentations/**/*.odp
/guides/publication/presentations/**/*_Office.pdf
/guides/**/__pycache__/
/tests/**/__pycache__/
