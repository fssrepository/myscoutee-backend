{
  "urlPath": "/game",
  "selectors": [
    ".event-chat-popup-shell .ui-popup__panel",
    ".chat-message"
  ],
  "absentSelectors": [
    "app-explanation-popup .ui-popup__panel",
    ".dialog",
    ".popup-loading-overlay",
    ".chat-message-pending",
    ".chat-message-timed-out"
  ],
  "network": [
    "/api/activities/chats"
  ],
  "noCrashText": true,
  "noBrokenImages": true,
  "noConsoleErrors": true,
  "maxMs": 140000
}
