{
  "name": "e2e profile state: preferences, experiences, rates, feedback, logout, delete",
  "group": "flows",
  "order": 9020,
  "method": "POST",
  "path": "/api/auth/me/filter-preferences",
  "script": "profile-state.mjs",
  "mutation": true,
  "e2eOnly": true,
  "headers": {
    "X-App-Session-Kind": "demo",
    "X-Demo-User-Id": "{{e2eUserId}}",
    "X-App-Session-Id": "e2e-profile-session-a-{{runId}}"
  },
  "setup": [
    {
      "name": "register primary profile session",
      "method": "POST",
      "path": "/api/auth/session/login",
      "headers": {
        "X-App-Session-Kind": "demo",
        "X-Demo-User-Id": "{{e2eUserId}}",
        "X-App-Session-Id": "e2e-profile-session-a-{{runId}}"
      },
      "expectedStatus": 200,
      "body": {
        "attemptId": "e2e-profile-attempt-a-{{runId}}",
        "provider": "demo"
      }
    },
    {
      "name": "register fallback profile session",
      "method": "POST",
      "path": "/api/auth/session/login",
      "headers": {
        "X-App-Session-Kind": "demo",
        "X-Demo-User-Id": "{{e2eUserId}}",
        "X-App-Session-Id": "e2e-profile-session-b-{{runId}}"
      },
      "expectedStatus": 200,
      "body": {
        "attemptId": "e2e-profile-attempt-b-{{runId}}",
        "provider": "demo"
      }
    }
  ],
  "body": {
    "userId": "{{e2eUserId}}",
    "filterPreferences": {
      "ageMin": 25,
      "ageMax": 38,
      "heightMinCm": 150,
      "heightMaxCm": 205,
      "interests": ["Hiking"],
      "values": ["Kindness"],
      "physiques": ["active"],
      "languages": ["en"],
      "genders": ["woman"],
      "traitLabels": ["Curious"],
      "smoking": [],
      "drinking": [],
      "workout": [],
      "pets": [],
      "familyPlans": [],
      "children": [],
      "loveStyles": [],
      "communicationStyles": [],
      "sexualOrientations": [],
      "religions": []
    }
  },
  "expectedStatus": 200,
  "maxMs": 5000
}
