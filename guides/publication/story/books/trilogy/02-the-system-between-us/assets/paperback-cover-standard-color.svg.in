<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink"
     width="{{TOTAL_WIDTH_IN}}in" height="9.25in"
     viewBox="0 0 {{TOTAL_WIDTH_U}} 9250">
  <title>MyScoutee Part II — KDP paperback cover — standard color, {{PAGE_COUNT}} pages</title>
  <defs>
    <linearGradient id="base" x1="0" y1="0" x2="0.9" y2="1">
      <stop offset="0" stop-color="#111a29"/>
      <stop offset="0.56" stop-color="#203950"/>
      <stop offset="1" stop-color="#282f44"/>
    </linearGradient>
    <radialGradient id="goldGlow" cx="50%" cy="50%" r="50%">
      <stop offset="0" stop-color="#f4b342" stop-opacity="0.19"/>
      <stop offset="1" stop-color="#f4b342" stop-opacity="0"/>
    </radialGradient>
    <radialGradient id="coralGlow" cx="50%" cy="50%" r="50%">
      <stop offset="0" stop-color="#c95f50" stop-opacity="0.18"/>
      <stop offset="1" stop-color="#c95f50" stop-opacity="0"/>
    </radialGradient>
  </defs>

  <rect x="0" y="0" width="{{TOTAL_WIDTH_U}}" height="9250" fill="url(#base)"/>
  <ellipse cx="4650" cy="1450" rx="2750" ry="2300" fill="url(#goldGlow)"/>
  <ellipse cx="900" cy="7700" rx="2300" ry="2150" fill="url(#coralGlow)"/>

  <image x="{{FRONT_X_U}}" y="{{FRONT_Y_U}}"
         width="{{FRONT_WIDTH_U}}" height="{{FRONT_HEIGHT_U}}"
         preserveAspectRatio="none" xlink:href="{{FRONT_ART_URI}}"/>

  <g fill="#f6f2ea">
    <text x="650" y="760" font-family="DejaVu Sans, sans-serif" font-size="145"
          font-weight="bold" letter-spacing="31" fill="#f4b342">MYSCOUTEE ORIGIN STORY  •  PART II</text>

    <text x="650" y="1450" font-family="DejaVu Serif, serif" font-size="295">
      <tspan x="650" dy="0">What happens when a person</tspan>
      <tspan x="650" dy="370">becomes evidence inside a system</tspan>
      <tspan x="650" dy="370">that no longer sees the whole life?</tspan>
    </text>

    <line x1="650" y1="2560" x2="5400" y2="2560" stroke="#f4b342" stroke-width="15" opacity="0.9"/>

    <text x="650" y="2940" font-family="DejaVu Serif, serif" font-size="180" fill="#e9edf2">
      <tspan x="650" dy="0" word-spacing="1.8" letter-spacing="0.3">Part II of The MyScoutee Trilogy enters an unresolved</tspan>
      <tspan x="650" dy="270" word-spacing="58.7" letter-spacing="7.7">period shaped by contracts, tax records, police</tspan>
      <tspan x="650" dy="270" word-spacing="51.9" letter-spacing="5.4">papers, petitions, courtrooms, and public events.</tspan>
      <tspan x="650" dy="270" word-spacing="11.4" letter-spacing="1.8">Peter Szabo follows the smaller route by which rules</tspan>
      <tspan x="650" dy="270">and institutions become measurable in a human life.</tspan>

      <tspan x="650" dy="400" word-spacing="18.2" letter-spacing="2.4">The System Between Us keeps documentary record,</tspan>
      <tspan x="650" dy="270" word-spacing="59.0" letter-spacing="6.1">attributed recollection, memoir, and later public</tspan>
      <tspan x="650" dy="270" word-spacing="57.4" letter-spacing="7.0">context explicitly distinct. It traces the attempt</tspan>
      <tspan x="650" dy="270" word-spacing="43.2" letter-spacing="7.4">to repair a failed process, the cost of becoming</tspan>
      <tspan x="650" dy="270" word-spacing="62.7" letter-spacing="8.4">legible through somebody else's label, and the</tspan>
      <tspan x="650" dy="270">work that continued under legal uncertainty.</tspan>
    </text>

    <text x="650" y="6830" font-family="DejaVu Serif, serif" font-size="225"
          font-style="italic" fill="#f3d18b">
      <tspan x="650" dy="0">This edition does not invent the ending.</tspan>
      <tspan x="650" dy="350">It records the path to the open door.</tspan>
    </text>

    <text x="650" y="7890" font-family="DejaVu Sans, sans-serif" font-size="150"
          font-weight="bold" letter-spacing="30" fill="#ffffff">PETER SZABO</text>
    <text x="650" y="8250" font-family="DejaVu Sans, sans-serif" font-size="118"
          letter-spacing="18" fill="#aebbc8">FIRST ENGLISH EDITION</text>
    <text x="650" y="8530" font-family="DejaVu Sans, sans-serif" font-size="105"
          letter-spacing="12" fill="#919eae">© 2026 MYSCOUTEE</text>
  </g>
{{SPINE_TEXT}}
</svg>
