  "scope": "Keep the four explicitly public active-document GET/HEAD endpoints readable without a valid member session. Preserve authentication and session checks for writes and protected member requests. No model, query, scheduler or seed change.",
  "defect": "In Firebase-disabled dev, an anonymous public read inherited the default member identity. After that member enrolled and logged out, session validation returned 401 before the configured public access rule.",
  "regression": {
    "before": {
      "tests": 28,
      "failed": 16,
      "passed": 12
    },
    "after": {
      "suites": 3,
      "tests": 45,
      "failures": 0,
      "errors": 0,
      "skipped": 0
    },
    "command": "tools/run-backend-junit.sh standard --tests '*FirebaseFilterPublicDocumentsTest' --tests '*FirebaseFilterOperatorTest' --tests '*WebSecurityConfigBootstrapTest' --tests '*SessionMongoRoutingFilterTest'",
    "note": "The WebSecurityConfigBootstrapTest pattern has no native class; 45 tests actually ran. The new test covers eight direct/API public routes, stale sessions and twelve protected POST/adjacent-route cases."
  },
